#: scenes/ui/timeline_settings_panel.gd:1740
msgid "Cloud cover"
msgstr "बादल आवरण"

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/timeline_settings_panel.gd:1741
msgid "Cloud density"
msgstr "बादल घनत्व"

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/timeline_settings_panel.gd:1742
msgid "Cirrus amount"
msgstr "सिरस मात्रा"

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/timeline_settings_panel.gd:1743
msgid "Cirrus wave scale"
msgstr "सिरस तरंग पैमाना"

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/timeline_settings_panel.gd:1744
msgid "Cirrus wave intensity"
msgstr "सिरस तरंग तीव्रता"

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/timeline_settings_panel.gd:1745
msgid "Cloud shadows"
msgstr "बादल की छाया"

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/timeline_settings_panel.gd:1749
msgid ""
"Cirrus adds high, streaky clouds (auto-driven by weather; slider is a boost). Cloud shadows dim the direct sun as clouds drift over — cheap global lighting, no ground projection."
msgstr ""
"सिरस उच्च, धारीदार बादल जोड़ता है (मौसम द्वारा संचालित; स्लाइडर एक बूस्ट है)। बादल के ऊपर से गुजरने पर बादल की छाया सीधी धूप को मंद करती है — सस्ती वैश्विक रोशनी, कोई ग्राउंड प्रोजेक्शन नहीं।"

# machine: ollama/gemma4:latest 2026-11-22
# qa: 5 Future climate scenario
#. budget: label
#: scenes/ui/timeline_settings_panel.gd:1761
msgid "Future Climate Scenario"
msgstr "भविष्य जलवायु परिदृश्य"

# machine: ollama/gemma4:latest 2026-11-22
#. budget: button
#: scenes/ui/timeline_settings_panel.gd:1763
msgid "Low (+1.5 °C by 2100, SSP1-2.6)"
msgstr "निम्न (+1.5 °C तक 2100 तक, SSP1-2.6)"

# machine: ollama/gemma4:latest 2026-11-22
#. budget: button
#: scenes/ui/timeline_settings_panel.gd:1764
