#. budget: label
#: scenes/ui/timeline_settings_panel.gd:855
msgid "Warn me when a hazard begins"
msgstr "जब कोई खतरा शुरू हो तो मुझे चेतावनी दें"

# machine: ollama/gemma4:latest 2026-11-22
