#. budget: label
#: system_graph/inspector_panel.gd:6035
msgid "Provision"
msgstr "تجهيز"

# machine: ollama/gemma4:latest 2026-11-22
#: system_graph/inspector_panel.gd:6047
msgid ""
"How many days of water, food and firewood to stock (and waste tanks to size) for {value} people"
msgstr ""
"كم يوم من الماء والغذاء والحطب لتخزينها (وتحديد حجم خزانات النفايات) لـ {value} شخص"

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: system_graph/inspector_panel.gd:6050
msgid "Stock up"
msgstr "تخزين الإمدادات"

# machine: ollama/gemma4:latest 2026-11-22
#. budget: tooltip
#: system_graph/inspector_panel.gd:6051
msgid ""
"Add or top up this habitat's supply and waste tanks for the chosen number of days — no wiring needed"
msgstr ""
"إضافة أو تعبئة خزانات الإمداد والنفايات لهذا الموطن لعدد الأيام المحدد — لا حاجة للأسلاك"

