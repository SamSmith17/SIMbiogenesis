msgstr ""
"La fuente debe estar POR ENCIMA de la turbina — arrastre más cuesta arriba."

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/siphon_hydro_modal.gd:1824
msgid "Couldn't place the intake there."
msgstr "No se pudo colocar la toma allí."

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/siphon_hydro_modal.gd:1852
