#: scenes/ui/siphon_hydro_modal.gd:1182
msgid ""
"Puts the pipe spec, route, operating point, annual estimate and every design check on the clipboard as plain text."
msgstr ""
"Coloca la especificación de la tubería, la ruta, el punto operativo, el cálculo anual y todas las comprobaciones de diseño en el portapapeles como texto sin formato."

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/siphon_hydro_modal.gd:1195
msgid "CT: green = prime · red = air break · drag water / levels on the cut."
msgstr ""
"CT: verde = prime · rojo = ruptura de aire · arrastrar agua / niveles en el corte."

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/siphon_hydro_modal.gd:1201
msgid ""
"Right-drag pans · wheel zooms at the cursor (Ctrl = fine) · F frames the turbine, Home the whole run · heading locked to source→outlet"
msgstr ""
"Arrastrar con el botón derecho sobre las cubetas · zoom con la rueda sobre el cursor (Ctrl = fino) · F enmarca la turbina, Inicio recorre todo · dirección bloqueada de fuente→salida"

# machine: ollama/gemma4:latest 2026-11-22
#: scenes/ui/siphon_hydro_modal.gd:1422
msgid "Hydro Lab — {name}"
msgstr "Laboratorio Hidráulico — {name}"

# machine: ollama/gemma4:latest 2026-11-22
