# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/timeline_settings_panel.gd:1729
msgid ""
"Standard FPV controls: WASD / left stick = fly horizontally, Shift or Up / triggers = ascend, Down = descend (Space stays free for look/time toggle), mouse / right stick = look direction. Changes apply immediately to any drone in the world."
msgstr ""
"Controles FPV estándar: WASD / joystick izquierdo = volar horizontalmente, Shift o Arriba / gatillos = ascender, Abajo = descender (Espacio libre para mirar/alternar tiempo), ratón / joystick derecho = dirección de la mirada. Los cambios se aplican inmediatamente a cualquier dron en el mundo."

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/timeline_settings_panel.gd:1740
msgid "Cloud cover"
msgstr "Cobertura nubosa"

