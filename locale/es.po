#: scenes/ui/siphon_hydro_modal.gd:786
msgid "Trace exit 3 m lower"
msgstr "Trazar salida 3 m más abajo"

# machine: ollama/gemma4:latest 2026-11-22
#. budget: tooltip
#: scenes/ui/siphon_hydro_modal.gd:788
msgid ""
"Walk the draft pipe further down the hill (steepest descent over the real terrain, never into the pond) until it has 3 m more drop."
msgstr ""
"Recorrer la tubería de aspiración más cuesta abajo (descenso más pronunciado sobre el terreno real, nunca hacia el estanque) hasta que tenga 3 m más de caída."

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/siphon_hydro_modal.gd:792
msgid "Re-trace"
msgstr "Retrazar"

# machine: ollama/gemma4:latest 2026-11-22
#. budget: tooltip
#: scenes/ui/siphon_hydro_modal.gd:793
msgid ""
"Route the draft pipe downhill again from the turbine (after sculpting, or to undo a hand-set exit)."
msgstr ""
"Dirigir la tubería de aspiración cuesta abajo de nuevo desde la turbina (después de esculpir, o para deshacer una salida manual)."

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/siphon_hydro_modal.gd:805
