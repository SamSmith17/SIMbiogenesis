#. budget: label
#: scenes/ui/timeline_settings_panel.gd:2147
msgid "High (16k, 128 MB VRAM)"
msgstr "Alta (16k, 128 MB VRAM)"

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/timeline_settings_panel.gd:2147
msgid "Standard (8k, 32 MB VRAM)"
msgstr "Estándar (8k, 32 MB VRAM)"

