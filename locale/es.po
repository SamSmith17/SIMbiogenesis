#: scenes/ui/siphon_hydro_modal.gd:1647
msgid "Place the turbine on the map first (Site Plan / 3D)."
msgstr "Coloque la turbina en el mapa primero (Plano del sitio / 3D)."

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/siphon_hydro_modal.gd:1673
msgid "No pond bound — Rebind to nearest pond first."
msgstr ""
"Sin estanque vinculado — Vuelva a vincular al estanque más cercano primero."

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/siphon_hydro_modal.gd:1679
