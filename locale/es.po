msgstr "Fuente de agua y tubería"

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/siphon_hydro_modal.gd:945
msgid "Route penstock…"
msgstr "Trazar tubería…"

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/siphon_hydro_modal.gd:954
msgid "From pond"
msgstr "Desde estanque"

# machine: ollama/gemma4:latest 2026-11-22
#. budget: label
#: scenes/ui/siphon_hydro_modal.gd:963
