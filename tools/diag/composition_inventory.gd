extends SceneTree

## Resource composition plan, Phase 0 (plans/RESOURCE_COMPOSITION_PLAN.md):
## every resource kind the game knows, where it is used, and what a
## composition table will need to give it (offline, read-only):
##   Godot --headless --path . --script tools/diag/composition_inventory.gd [-- --out=<file.md>]
##
## Kinds come from ResourceKinds.BUILTIN (custom kinds in the player's
## user://resource_kinds.cfg are listed apart, read only) plus every kind
## named by a library preset (ComponentPresets' const lists) and a builtin
## process recipe (ProcessRecipeCatalog.BUILTINS). Kinds are normalised
## through ResourceKinds' aliases. Plants, catchments and habitats have I/O
## the flow engine implies rather than lists; those are added by hand below
## (IMPLIED) so the usage counts are honest.
##
## Prints one markdown table: kind, display, unit, dimension, material?,
## mass basis needed, used as input / output (preset + recipe counts), and
## the names of the presets that use it.

## I/O the flow engine implies for preset TYPES without input/output lists
## (resource_flow_engine.gd _process_plant / _process_catchment / habitat).
const IMPLIED := {
	"plant": {"in": ["water", "nutrients", "sunlight"], "out": ["biomass", "food"]},
	"catchment": {"in": ["rain"], "out": ["water"]},
}


var _uses: Dictionary = {}   # kind -> {in: n, out: n, presets: {label: true}}


func _initialize() -> void:
	var out_path := ""
	for a in OS.get_cmdline_user_args():
		if str(a).begins_with("--out="):
			out_path = str(a).substr(6)
	var lists := {"PROCESSORS": ComponentPresets.PROCESSORS, "HABITATS": ComponentPresets.HABITATS,
		"RESOURCES": ComponentPresets.RESOURCES, "PBIS": ComponentPresets.PBIS,
		"CATCHMENTS": ComponentPresets.CATCHMENTS, "PLANTS": ComponentPresets.PLANTS,
		"WIND_TURBINES": ComponentPresets.WIND_TURBINES, "HYDRO_TURBINES": ComponentPresets.HYDRO_TURBINES,
		"CSP_CONCENTRATORS": ComponentPresets.CSP_CONCENTRATORS, "TOOLS": ComponentPresets.TOOLS,
		"APPLIANCES": ComponentPresets.APPLIANCES}
	for list_name in lists.keys():
		for p in lists[list_name]:
			_scan_preset(p as Dictionary, str(list_name))
	for r in ProcessRecipeCatalog.BUILTINS:
		var rd: Dictionary = r
		var lbl := "recipe: " + str(rd.get("label", rd.get("id", "")))
		for io in rd.get("inputs", []):
			_use(str((io as Dictionary).get("kind", "")), "in", lbl)
		for io2 in rd.get("outputs", []):
			_use(str((io2 as Dictionary).get("kind", "")), "out", lbl)

	var lines: PackedStringArray = []
	lines.append("# Resource kind inventory (Phase 0)")
	lines.append("")
	lines.append("Generated by `tools/diag/composition_inventory.gd`. Counts are library presets + builtin recipes that name the kind.")
	lines.append("")
	lines.append("| kind | display | unit | dimension | material | mass basis | in | out | used by |")
	lines.append("|---|---|---|---|---|---|---|---|---|")
	var kinds: Array = ResourceKinds.BUILTIN.keys()
	for k in _uses.keys():
		if not kinds.has(k):
			kinds.append(k)
	kinds.sort()
	var unregistered: Array = []
	for k in kinds:
		var kid := str(k)
		var registered := ResourceKinds.BUILTIN.has(kid)
		if not registered:
			unregistered.append(kid)
		var meta: Dictionary = ResourceKinds.BUILTIN.get(kid, {})
		var unit := str(meta.get("unit", "?"))
		var dim := ResourceKinds.dimension_for_kind(kid) if registered else "?"
		var material := CompositionCatalog.is_material(kid)
		var u: Dictionary = _uses.get(kid, {"in": 0, "out": 0, "presets": {}})
		var names: Array = (u["presets"] as Dictionary).keys()
		names.sort()
		var shown := ", ".join(names.slice(0, 6))
		if names.size() > 6:
			shown += " (+%d)" % (names.size() - 6)
		lines.append("| %s%s | %s | %s | %s | %s | %s | %d | %d | %s |" % [kid,
			"" if registered else " ⚠", str(meta.get("display", "")), unit, dim,
			"yes" if material else "no", _basis_of(kid, unit, material), int(u["in"]),
			int(u["out"]), shown])
	lines.append("")
	lines.append("⚠ = named by a preset or recipe but not a ResourceKinds builtin: %s" % (", ".join(unregistered) if not unregistered.is_empty() else "none"))
	var custom: Array = []
	for k2 in ResourceKinds.all_kinds():
		if ResourceKinds.is_custom_kind(str(k2)):
			custom.append(str(k2))
	lines.append("")
	lines.append("Custom kinds in this user's resource_kinds.cfg (not shipped): %s" % (", ".join(custom) if not custom.is_empty() else "none"))
	var unused: Array = []
	for k3 in ResourceKinds.BUILTIN.keys():
		if not _uses.has(k3):
			unused.append(str(k3))
	unused.sort()
	lines.append("")
	lines.append("Builtin kinds no preset or recipe names: %s" % (", ".join(unused) if not unused.is_empty() else "none"))
	var text := "\n".join(lines)
	print(text)
	if not out_path.is_empty():
		var f := FileAccess.open(out_path, FileAccess.WRITE)
		if f != null:
			f.store_string(text + "\n")
			f.close()
			print("\nwrote ", out_path)
	quit(0)


func _scan_preset(p: Dictionary, list_name: String) -> void:
	var specs: Dictionary = p.get("specs", {})
	var lbl := "%s" % str(p.get("label", ""))
	var ty := str(p.get("type", ""))
	for io in specs.get("inputs", []):
		_use(str((io as Dictionary).get("kind", "")), "in", lbl)
	for io2 in specs.get("outputs", []):
		_use(str((io2 as Dictionary).get("kind", "")), "out", lbl)
	if ty == "resource":
		var rk := str(specs.get("resource_kind", ""))
		if not rk.is_empty():
			_use(rk, "store", lbl)
	if IMPLIED.has(ty):
		var imp: Dictionary = IMPLIED[ty]
		for k in imp["in"]:
			_use(str(k), "in", lbl)
		for k2 in imp["out"]:
			if str(k2) == "food" and float(specs.get("food_fraction", 0.0)) <= 0.0:
				continue
			if str(k2) == "biomass" and float(specs.get("food_fraction", 0.0)) > 0.0:
				continue
			_use(str(k2), "out", lbl)
	if list_name == "PBIS":
		var pk := str(specs.get("pbi_kind", specs.get("kind", "")))
		if not pk.is_empty():
			_use(pk, "out", lbl)


func _use(kind: String, dir: String, label: String) -> void:
	if kind.is_empty() or kind == "part":
		return
	var k := ResourceKinds.normalize_kind(kind)
	if not _uses.has(k):
		_uses[k] = {"in": 0, "out": 0, "presets": {}}
	if dir == "in" or dir == "out":
		_uses[k][dir] = int(_uses[k][dir]) + 1
	(_uses[k]["presets"] as Dictionary)[label] = true


## The catalog's mass basis, or what one would need.
static func _basis_of(kind: String, unit: String, material: bool) -> String:
	if material and not CompositionCatalog.row(kind).is_empty():
		var kgu := CompositionCatalog.kg_per_unit(kind)
		return "%s kg/%s%s" % [str(snappedf(kgu, 0.001)), unit if unit != "?" else "unit", " (est)" if CompositionCatalog.is_estimate(kind) else ""]
	return _basis(unit, material)


static func _basis(unit: String, material: bool) -> String:
	if not material:
		return "— (energy / non-material)"
	match unit:
		"kg":
			return "1 kg/kg"
		"L":
			return "density kg/L"
		"m³":
			return "gas density kg/m³ (NTP)"
		"kWh", "kW":
			return "check: energy unit on a material?"
		_:
			return "kg per %s" % unit
