extends SceneTree

## How far every library preset and builtin recipe is from closing MASS and
## ELEMENTS (resource composition plan, plans/RESOURCE_COMPOSITION_PLAN.md).
## Offline, read-only:
##   Godot --headless --path . --script tools/diag/preset_balance_audit.gd [-- --out=<file.md>]
##
## Rows come from PresetBalance (core/composition/preset_balance.gd): each
## preset at its listed rates with its own air mode and retained elements.
## Δ = out − in after the air side is closed (kg/h, per batch for recipes);
## "air" lists the gases given off (+) and taken in (−). Verdicts are
## MassBalance's: ok, estimate (on estimated make-ups), unbalanced (an
## element appears or goes missing), unknown (a kind has no make-up),
## source / sink (material only out / only in, by design), runtime (no
## rates listed; the engine sets them live).

const SHOW := ["C", "H", "O", "N", "P", "K"]

var _lines: PackedStringArray = []
var _tally: Dictionary = {}


func _initialize() -> void:
	var out_path := ""
	for a in OS.get_cmdline_user_args():
		if str(a).begins_with("--out="):
			out_path = str(a).substr(6)
	_lines.append("# Preset mass + element balance audit")
	_lines.append("")
	_lines.append("Generated by `tools/diag/preset_balance_audit.gd` from `PresetBalance` (core/composition/). Δ = out − in after the air side is closed, kg/h; %% = Δ over the larger side. Tolerance %d %%." % int(MassBalance.DEFAULT_TOL * 100.0))
	var group := ""
	for r in PresetBalance.rows():
		var rd: Dictionary = r
		if str(rd["group"]) != group:
			group = str(rd["group"])
			_lines.append("")
			_lines.append("## " + group)
			_lines.append("")
			_header()
		_row(rd)
	_lines.append("")
	var tally_txt: PackedStringArray = []
	for v in _tally.keys():
		tally_txt.append("%s %d" % [str(v), int(_tally[v])])
	_lines.append("**Totals:** " + ", ".join(tally_txt))
	var text := "\n".join(_lines)
	print(text)
	if not out_path.is_empty():
		var f := FileAccess.open(out_path, FileAccess.WRITE)
		if f != null:
			f.store_string(text + "\n")
			f.close()
			print("\nwrote ", out_path)
	quit(0)


func _header() -> void:
	var cols := "| preset | in kg/h | out kg/h | Δmass |"
	var sep := "|---|---|---|---|"
	for e in SHOW:
		cols += " Δ%s |" % e
		sep += "---|"
	_lines.append(cols + " air | verdict |")
	_lines.append(sep + "---|---|")


func _row(rd: Dictionary) -> void:
	var v := str(rd["verdict"])
	_tally[v] = int(_tally.get(v, 0)) + 1
	var mb: Dictionary = rd["mb"]
	if v == "runtime":
		_lines.append("| %s | — | — | — |%s — | runtime |" % [str(rd["label"]), " — |".repeat(SHOW.size())])
		return
	var kin := float((mb["in"] as Dictionary)["kg"])
	var kout := float((mb["out"] as Dictionary)["kg"])
	var cells := "| %s | %s | %s | %s |" % [str(rd["label"]), _f(kin), _f(kout), _pct(float(mb["mass_delta_kg"]), maxf(kin, kout))]
	for e in SHOW:
		var a := float((mb["in"]["elements"] as Dictionary).get(e, 0.0))
		var b := float((mb["out"]["elements"] as Dictionary).get(e, 0.0))
		cells += " %s |" % (_f(b - a) if maxf(a, b) > 1e-9 else "·")
	var gases := PackedStringArray()
	for g in (mb["air"] as Dictionary).keys():
		gases.append("%s %s" % [str(g), _f(float(mb["air"][g]))])
	var words := v
	if not (mb["loses"] as Array).is_empty():
		words += "; loses " + ", ".join(mb["loses"])
	if not (mb["creates"] as Array).is_empty():
		words += "; creates " + ", ".join(mb["creates"])
	if not (mb["unknown"] as Array).is_empty():
		words += ": " + ", ".join(mb["unknown"])
	if not (mb["retained"] as Dictionary).is_empty():
		words += " (keeps " + ", ".join((mb["retained"] as Dictionary).keys()) + ")"
	_lines.append(cells + " %s | %s |" % [", ".join(gases) if not gases.is_empty() else "·", words])


static func _f(x: float) -> String:
	if absf(x) < 1e-9:
		return "0"
	if absf(x) >= 10.0:
		return "%.1f" % x
	if absf(x) >= 0.1:
		return "%.2f" % x
	return "%.4f" % x


static func _pct(d: float, big: float) -> String:
	if big <= 1e-9:
		return "·"
	return "%+d%%" % int(round(100.0 * d / big))
