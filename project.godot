; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="SIMbiogenesis"
config/version="0.1.0"
run/main_scene="res://scenes/ui/map_select/map_select.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/icon.png"

[autoload]

ArtPacks="*res://core/art_packs.gd"
Services="*res://core/services.gd"
PerfMonitor="*res://core/perf/perf_monitor.gd"
DeviceRegistry="*res://power_system/core/device_registry.gd"
AutomationEngine="*res://power_system/automation/automation_engine.gd"
SaveSystem="*res://core/save_system.gd"
GhiService="*res://scenes/ui/location_picker/ghi_service.gd"
InverterBridge="*res://core/inverter_bridge.gd"
TimeDirector="*res://core/time_director.gd"
SimMode="*res://core/sim_mode.gd"
AcPowerBus="*res://core/ac_power_bus.gd"
WeatherService="*res://core/weather_service.gd"
NwsZoneService="*res://core/nws_zone_service.gd"
NwsAlertService="*res://core/nws_alert_service.gd"
GistempService="*res://core/gistemp_service.gd"
ClimateProjectionService="*res://core/climate_projection_service.gd"
ElevationService="*res://core/terrain/elevation_service.gd"
ImageryService="*res://core/terrain/imagery_service.gd"
BuildingService="*res://core/terrain/building_service.gd"
VegetationService="*res://core/terrain/vegetation_osm_service.gd"
MapContext="*res://core/terrain/map_context.gd"
DesignContext="*res://core/terrain/design_context.gd"
GameplayRules="*res://gameplay/gameplay_rules.gd"
CameraServerBootstrap="*res://scenes/ui/projection/camera_server_bootstrap.gd"
CursorController="*res://scenes/ui/cursor_controller.gd"
SimSettingsController="*res://scenes/ui/sim_settings_controller.gd"
VegetationEnvironmentSync="*res://vegetation/vegetation_environment_sync.gd"
VegetationWindDriver="*res://vegetation/vegetation_wind_driver.gd"
PlaytestHarness="*res://core/terrain/playtest_harness.gd"
MapillaryService="*res://core/terrain/mapillary_service.gd"
AiImageryService="*res://core/terrain/ai_imagery_service.gd"
SoiService="*res://core/soi/soi_service.gd"
DiscordIdentity="*res://core/discord/discord_identity.gd"
DiscordDirectory="*res://core/discord/discord_directory.gd"
MultiplayerSession="*res://core/multiplayer/multiplayer_session.gd"
UiSound="*res://core/ui_sfx.gd"
AirQualityService="*res://core/weather/air_quality_service.gd"
ExtremeWeather="*res://core/weather/extreme_weather_director.gd"
Microclimate="*res://core/microclimate/microclimate_resolver.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

filesystem/other_file_extensions="mp4,webm,mkv,avi,mov,m4v"

[editor_plugins]

enabled=PackedStringArray("res://addons/CameraServerExtension/plugin.cfg", "res://addons/spacemouse_editor/plugin.cfg", "res://addons/sketchup_import_fix/plugin.cfg")

[filesystem]

import/blender/enabled=false
import/fbx/enabled=false
file_server/password=""

