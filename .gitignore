# Godot 4+ editor data (local; do not commit)
.godot/

# Imported-file metadata. Removing this line commits *.import for reproducible clones
# across machines at the cost of larger diffs and merge noise.
*.import

# Local export outputs (see export_presets.cfg paths under build/).
# ANCHORED to the repo root: an unanchored `build/` also matched the
# core/linkage/build/ source module, which then never reached GitHub and
# a fresh clone could not compile (2026-10-20).
/build/
/export/
/release/

# OS
.DS_Store
Thumbs.db
desktop.ini

# If someone mistakenly copies runtime configs into the project tree, do not track them.
# Real saves live under user:// (see docs/LOCAL_CONFIG.md).
**/ha_connection.cfg
**/uisp_settings.cfg
**/solar_ui_ha_entities.cfg
**/solar_panel_config.cfg
**/star_calibration.cfg
**/location_prefs.cfg
**/terrain_config.cfg
**/keys_config.cfg
**/climate_prefs.cfg
**/weather_gen_engine.cfg
**/sim_settings.cfg
**/ui_prefs.cfg
**/planet_prefs.cfg
**/saves/

# Multiplayer + Discord runtime state. These only ever live under user://, so
# these lines are belt-and-braces against a stray copy inside the tree — but
# discord_auth.cfg holds a real OAuth refresh token and a community file holds
# webhook write credentials, so they are worth naming explicitly.
**/mp_prefs.cfg
**/mp_telemetry.log
**/discord_auth.cfg
**/discord_config.cfg
**/discord_cache.cfg
**/communities/
**/*.simcommunity

# Godot headless / import TMP artifacts, and the editor's hot-reload copies
# of GDExtension libraries (it recreates them on every load)
**/~*.TMP
**/~*.dll
**/~*.so
**/~*.dylib
**/*~RF*.TMP

# HA data exports and site-specific reports (never commit real entity history)
/Full SOAK 2026 Datastream*
/starshade_soak_report*.html

# Local bespoke maps (maintainer copies; see maps/examples/ and docs/ASSETS.md)
/scenes/maps/soak_festival_2026.tscn
/scenes/maps/mars_aerial.tscn
/scenes/maps/mars_main_legacy.tscn
/maps/soak_camp_map.tres
/maps/mars_aerial_map.tres
/main.tscn

# Future local env files (not used by core Godot; safe to ignore if added later)
.env
.env.*
!.env.example

# LinkageLab local test exports (embedded GLB payloads — not source)
*.gamebundle.json

# -----------------------------------------------------------------------------
# GitHub lite — heavy art ships via a local asset pack (see docs/ASSETS.md)
# -----------------------------------------------------------------------------
/Imported Models/
/StarShade FBX/
/Starshade Pretty Version/
/Player Character/
/Wood034_1K-JPG/
/Metal051C_1K-JPG/

# Scriptless leaf scene whose root node instances a gitignored GLB directly —
# nothing in the tracked codebase currently loads it (only bespoke, already-
# gitignored map scenes do), so there's no script to attach a fallback to.
/scenes/gameplay/Tree.tscn

# Root-level map blobs. Since 2026-10-20 this art lives under /Imported Models/
# and /Starshade Pretty Version/; the patterns stay so an older asset pack that
# unpacks to the root still cannot be committed by accident.
/SoakSim.exe
/10m_*.obj
/10m_*.STL
/Mars *.glb
/Mars*.jpg
/Mars*.png
/motorhome.glb
/motorhome_*.jpg
/Starshade Pretty Version*.glb
/Starshade Pretty Version*.jpg
/Starshade Pretty Version*.png
/Bombay Beach*.jpg

# -----------------------------------------------------------------------------
# Local debug artifacts (throwaway working files — never commit)
# -----------------------------------------------------------------------------
/debug_log.txt
**/*.import*.tmp
/*.patch
/*.diff
# Root-level one-off debug/diagnostic scripts
/test_script.gd
/test_gltf.gd
/dump_props.gd
/debug_analyzer.gd
# Accidental LinkageLab glTF exports dropped at the repo root
/LinkageLab_Export_*.gltf
# Godot-quarantined unloadable scenes
**/*.tscn.broken
# Python bytecode from the tools/ scripts
__pycache__/
*.pyc

# -----------------------------------------------------------------------------
# Plans, status matrices and working notes (human or AI) — local only.
# Write them in /plans/; the root patterns catch one dropped at the top level.
# Documentation that should ship goes in docs/ instead.
# -----------------------------------------------------------------------------
/plans/
/*PLAN*.md
/*_PLAN*.md
/PHASE*_*.md
/WAVE*_*.md
/*_INVENTORY.md
/*_MATRIX.md
/*_WALKTHROUGH.md

# Claude Code local state (the shared .claude/ settings, if any, stay tracked)
.claude/settings.local.json
.claude/worktrees/

# Temporary uid tables tools/release/build_release.py writes during a build
/art_uids/
