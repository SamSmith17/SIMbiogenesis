extends SceneTree

## Offline deterministic selftest for the LinkageLab solver port
## (core/linkage/linkage_params.gd, linkage_kinematics.gd, linkage_solver.gd).
##
## Reference values were generated by running the REAL LinkageLab web-app
## solver (js/linkage/solver.js + joint-kinematics.js) headlessly in node:
##   node tools/linkage_reference.mjs <path-to-LinkageLab-repo>
## Re-generate + re-pin whenever the upstream JS solver changes.
##
## Run: Godot.exe.exe --headless --path . --script core/linkage/linkage_selftest.gd

var _fails := 0
var _checks := 0


# _initialize (not _init): runs after autoloads register, so the modal
# compile smoke can resolve autoload identifiers (CursorController).
func _initialize() -> void:
	_test_joint_positions()
	_test_closed_and_min_angles()
	_test_solve_cyl_default()
	_test_solve_cyl_bolts()
	_test_solve_cyl_starshade()
	_test_solve_arch_caps()
	_test_solve_arch_array3()
	_test_solve_cyl_fixed()
	_test_config_roundtrip()
	_test_canopy_and_module_frames()
	_test_support_beams()
	_test_panel_layouts()
	_test_arch_faces_and_panels()
	_test_structure_builder()
	_test_builder_support_panels()
	_test_world_placement_runtime()
	_test_solar_handoff()
	_test_modal_script_compiles()
	_test_shipped_presets()
	_test_lossless_presets()
	_test_parity_fixtures()
	_test_part_key_selectors()
	_test_part_keys_parity()
	_test_builder_part_state()
	_test_beam_holes_parity()
	_test_hardware_config_roundtrip()
	_test_bom()
	_test_bom_copies()
	_test_fold_sequence()
	_test_floor_parity()
	_test_drill_plan()
	_test_fab_graph()
	_test_build_guide()
	_test_hw_layout()
	_test_hw_presets()
	_test_hardware_spacing()
	_test_hw_parts()
	_test_hw_layout_reference()
	_test_hw_placement_reference()
	_test_hw_param_fields()
	_test_hw_preview_context()
	_test_hardware_modal()
	_test_credits_lockstep()
	if _fails == 0:
		print("linkage_selftest: PASS (%d checks)" % _checks)
	else:
		print("linkage_selftest: FAIL (%d/%d)" % [_fails, _checks])
	quit(0 if _fails == 0 else 1)


func _check(cond: bool, label: String) -> void:
	_checks += 1
	if not cond:
		_fails += 1
		print("  FAIL: ", label)


func _feq(a: float, b: float, tol: float, label: String) -> void:
	_check(absf(a - b) <= tol, "%s: %.9f vs %.9f (tol %s)" % [label, a, b, tol])


func _v2eq(a: Vector2, b: Vector2, tol: float, label: String) -> void:
	_check(a.distance_to(b) <= tol, "%s: %s vs %s" % [label, a, b])


func _v3eq(a: Vector3, b: Vector3, tol: float, label: String) -> void:
	_check(a.distance_to(b) <= tol, "%s: %s vs %s" % [label, a, b])


# ---------------------------------------------------------------------------
# Joint kinematics — pinned to calculateJointPositions reference output
# ---------------------------------------------------------------------------

func _test_joint_positions() -> void:
	# case fold=2.363175807 h=93 pct=41.5 hob=0 pa=0
	var r := LinkageKinematics.calculate_joint_positions(2.363175807, 93.0, 41.5, 0.0, 0.0)
	var j: Dictionary = r["joints"]
	_v2eq(j["bl"], Vector2(-14.645110477, 35.708469081), 0.001, "joints1 bl")
	_v2eq(j["br"], Vector2(-14.645110477, -35.708469081), 0.001, "joints1 br")
	_v2eq(j["tl"], Vector2(20.644312359, 50.336034729), 0.001, "joints1 tl")
	_v2eq(j["tr"], Vector2(20.644312359, -50.336034729), 0.001, "joints1 tr")
	_feq(r["relative_rotation"], -0.785891924, 1e-6, "joints1 rel")
	_feq(r["active_length"], 38.595, 1e-9, "joints1 act")
	_feq(r["passive_length"], 54.405, 1e-9, "joints1 pas")

	# case fold=90deg
	r = LinkageKinematics.calculate_joint_positions(1.570796327, 93.0, 41.5, 0.0, 0.0)
	j = r["joints"]
	_v2eq(j["bl"], Vector2(-27.290786220, 27.290786220), 0.001, "joints2 bl")
	_v2eq(j["tr"], Vector2(38.470144430, -38.470144430), 0.001, "joints2 tr")
	_feq(r["relative_rotation"], -0.336780314, 1e-6, "joints2 rel")

	# case fold=60deg h=80 pct=50 hoberman=10 pivotAng=-5 (angulated + asymmetric)
	r = LinkageKinematics.calculate_joint_positions(1.047197551, 80.0, 50.0, 10.0, -5.0)
	j = r["joints"]
	_v2eq(j["bl"], Vector2(-34.641016151, 20.0), 0.001, "joints3 bl")
	_v2eq(j["br"], Vector2(-36.252311481, -16.904730470), 0.001, "joints3 br")
	_v2eq(j["tl"], Vector2(38.637033052, 10.352761804), 0.001, "joints3 tl")
	_v2eq(j["tr"], Vector2(37.587704831, -13.680805733), 0.001, "joints3 tr")
	_feq(r["relative_rotation"], 0.174532925, 1e-6, "joints3 rel")

	# case fold=170deg h=120 pct=30 hoberman=-8 pivotAng=12
	r = LinkageKinematics.calculate_joint_positions(2.967059728, 120.0, 30.0, -8.0, 12.0)
	j = r["joints"]
	_v2eq(j["bl"], Vector2(-3.137606739, 35.863009131), 0.001, "joints4 bl")
	_v2eq(j["br"], Vector2(4.387296363, -35.731661459), 0.001, "joints4 br")
	_v2eq(j["tl"], Vector2(-21.740799789, 81.137769408), 0.001, "joints4 tl")
	_v2eq(j["tr"], Vector2(-4.396220324, -83.884880919), 0.001, "joints4 tr")
	_feq(r["relative_rotation"], -3.711880299, 1e-6, "joints4 rel")

	# pivot_span is derivable from the pinned joints (tr-br distance).
	var p := _default_params()
	var expected_span := Vector2(20.644312359, -50.336034729).distance_to(Vector2(-14.645110477, -35.708469081))
	_feq(LinkageKinematics.pivot_span(p, 2.363175807), expected_span, 0.002, "pivot_span default")


func _default_params() -> LinkageParams:
	# Mirrors the app-state.js defaults used by tools/linkage_reference.mjs.
	var p := LinkageParams.new()
	p.modules = 8
	p.h_length_ft = 8.0
	p.v_length_ft = 8.0
	p.pivot_pct = 41.5
	p.hoberman_ang = 0.0
	p.pivot_ang = 0.0
	p.h_stack_count = 2
	p.v_stack_count = 3
	p.v_stack_reverse = false
	p.offset_top_in = 1.5
	p.offset_bot_in = 1.5
	p.vert_end_offset = 1.5
	p.h_stack_gap = 0.0
	p.v_stack_gap = 0.0
	p.h_beam_w = 3.5
	p.h_beam_t = 1.5
	p.v_beam_w = 1.5
	p.v_beam_t = 3.5
	p.v_beam_dimensions_linked = true
	p.bracket_width = 2.0
	p.bracket_depth = 3.0
	p.bracket_height = 3.0
	p.bracket_wall_thickness = 0.25
	p.bracket_inner_width = 1.5
	p.bracket_hole_diameter = 0.375
	p.bracket_hole_distance = 1.5
	p.bolt_diameter = 0.375
	p.v_bolt_length = 3.0
	p.v_bolt_inner_length = 3.0
	p.v_bolt_outer_length = 2.0
	p.h_bolt_length = 3.0
	p.h_pivot_bolt_length = 4.0
	p.fold_angle = 135.4 * PI / 180.0
	p.show_brackets = true
	p.show_bolts = false
	p.orientation = "horizontal"
	p.arch_cap_uprights = false
	p.use_fixed_beams = false
	p.array_count = 1
	return p


func _test_closed_and_min_angles() -> void:
	var p := _default_params()
	_feq(LinkageKinematics.optimal_closed_angle(p), 2.363175807, 1e-6, "closed8")
	_feq(LinkageKinematics.min_fold_angle_v_overlap(p), 0.087266463, 0.002, "minFold8")
	p.modules = 12
	p.pivot_pct = 35.0
	_feq(LinkageKinematics.optimal_closed_angle(p), 1.457349925, 1e-6, "closed12_35")


# ---------------------------------------------------------------------------
# Full solve — pinned to solveLinkage reference summaries
# ---------------------------------------------------------------------------

func _beam_type_counts(beams: Array) -> Dictionary:
	var counts := {}
	for b in beams:
		var t: String = b["stack_type"]
		counts[t] = int(counts.get(t, 0)) + 1
	return counts


func _corner_sum(beams: Array) -> Vector3:
	# Accumulate in 64-bit scalars; corners themselves are float32 Vector3s.
	var sx := 0.0
	var sy := 0.0
	var sz := 0.0
	for b in beams:
		for c in b["corners"]:
			var v: Vector3 = c
			sx += v.x
			sy += v.y
			sz += v.z
	return Vector3(sx, sy, sz)


func _corner_count(beams: Array) -> int:
	var n := 0
	for b in beams:
		n += (b["corners"] as Array).size()
	return n


func _test_solve_cyl_default() -> void:
	var p := _default_params()
	var s := LinkageSolver.solve(p, p.fold_angle)
	var beams: Array = s["beams"]
	_check(beams.size() == 56, "cyl_default beams=56 got %d" % beams.size())
	_check((s["brackets"] as Array).size() == 32, "cyl_default brackets=32")
	_check((s["bolts"] as Array).size() == 0, "cyl_default bolts=0")
	var counts := _beam_type_counts(beams)
	_check(int(counts.get("horizontal-bottom", 0)) == 16, "cyl_default h-bottom=16")
	_check(int(counts.get("horizontal-top", 0)) == 16, "cyl_default h-top=16")
	_check(int(counts.get("vertical", 0)) == 24, "cyl_default vertical=24")
	_feq(s["max_rad"], 229.126269296, 0.01, "cyl_default maxRad")
	_feq(s["max_height"], 93.792045376, 0.01, "cyl_default maxHeight")
	_check(_corner_count(beams) == 448, "cyl_default 448 corners")
	_v3eq(_corner_sum(beams), Vector3(-45125.435716248, 20337.418164310, 6.501081388), 0.6, "cyl_default cornerSum")
	var b0: Dictionary = beams[0]
	_v3eq(b0["p1"], Vector3(-15.214294716, -0.75, 37.096283659), 0.002, "cyl_default beam0.p1")
	_v3eq(b0["p2"], Vector3(21.213496598, -0.75, -51.723849306), 0.002, "cyl_default beam0.p2")
	_check(b0["stack_type"] == "horizontal-bottom" and absf(float(b0["w"]) - 3.5) < 1e-6 and absf(float(b0["t"]) - 1.5) < 1e-6, "cyl_default beam0 dims/type")
	var bn: Dictionary = beams[beams.size() - 1]
	_v3eq(bn["p1"], Vector3(-15.643732364, 1.632386365, 36.522157666), 0.002, "cyl_default beamN.p1")
	_v3eq(bn["p2"], Vector3(20.843418631, 89.159659011, 51.477569908), 0.002, "cyl_default beamN.p2")
	_check(bn["stack_type"] == "vertical", "cyl_default beamN type")
	var br0: Dictionary = (s["brackets"] as Array)[0]
	_v3eq(br0["pos"], Vector3(-14.645110477, 0.0, -35.708469081), 0.002, "cyl_default bracket0.pos")
	_check(bool(br0["is_bottom"]), "cyl_default bracket0 isBottom")
	var basis: Basis = br0["basis"]
	_v3eq(basis.x, Vector3(0.382911508, 0.0, 0.923785027), 1e-5, "cyl_default bracket0 basis.x")
	_v3eq(basis.y, Vector3(0.0, 1.0, 0.0), 1e-5, "cyl_default bracket0 basis.y")
	_v3eq(basis.z, Vector3(-0.923785027, 0.0, 0.382911508), 1e-5, "cyl_default bracket0 basis.z")
	_check((s["module_frames"] as Array).size() == 8, "cyl_default 8 module frames")


func _test_solve_cyl_bolts() -> void:
	var p := _default_params()
	p.show_bolts = true
	var s := LinkageSolver.solve(p, p.fold_angle)
	var bolts: Array = s["bolts"]
	_check(bolts.size() == 88, "cyl_bolts bolts=88 got %d" % bolts.size())
	var b0: Dictionary = bolts[0]
	_v3eq(b0["start"], Vector3(-14.645110477, -2.0, -35.708469081), 0.002, "cyl_bolts bolt0.start")
	_v3eq(b0["end"], Vector3(-14.645110477, 2.0, -35.708469081), 0.002, "cyl_bolts bolt0.end")
	_feq(b0["radius"], 0.1875, 1e-9, "cyl_bolts bolt0.radius")
	_check(b0["bolt_type"] == "hpivot" and b0["bolt_sub_type"] == "bottom", "cyl_bolts bolt0 type")
	var sx := 0.0
	var sy := 0.0
	var sz := 0.0
	for b in bolts:
		var c: Vector3 = b["center"]
		sx += c.x
		sy += c.y
		sz += c.z
	_v3eq(Vector3(sx, sy, sz), Vector3(-8863.788095270, 3994.849996561, 0.386330144), 0.2, "cyl_bolts boltCenterSum")


