func _test_config_roundtrip() -> void:
	# Subset of the real configs/starshade-default.json from the web app.
	var starshade_cfg := {
		"structure": {
			"modules": 8,
			"beamLengths": {"horizontal": 8, "vertical": 8},
			"pivotPercent": 41.4,
			"stackCounts": {"horizontal": 2, "vertical": 3},
			"beamDimensions": {
				"horizontalWidth": 3.5, "horizontalThickness": 1.5,
				"verticalWidth": 1.5, "verticalThickness": 3.5,
			},
			"offsets": {"top": 1.75, "bottom": 2, "vertEnd": 1, "hStackGap": 0.1, "vStackGap": 0.45},
			"brackets": {
				"width": 2.17, "depth": 1.6, "height": 3.82,
				"wallThickness": 0.18, "innerWidth": 1.8, "holeDiameter": 0.3125,
			},
			"bracketDimensions": {"holeDistance": 2.69},
			"bolts": {"diameter": 0.5, "vStackLength": 6.4, "hStackLength": 3, "vStackAuto": false, "hStackAuto": false},
			"hobermanAngle": 0, "pivotAngle": 0, "vStackReverse": true,
		},
		"mode": {"type": "cylinder", "flipVertical": false, "rotation": 0, "useFixedBeams": false, "capUprights": true, "arrayCount": 1},
		"foldAngle": 134.9,
		"supportBeams": {"enabled": true, "length": 120, "offsetH": -46.5, "offsetV": -6.8},
		"visibility": {"brackets": true, "bolts": true},
		"version": "v30",
	}
	var p := LinkageParams.new()
	p.from_config(starshade_cfg)
	_check(p.modules == 8, "cfg modules")
	_feq(p.pivot_pct, 41.4, 1e-9, "cfg pivotPercent")
	_check(p.v_stack_reverse, "cfg vStackReverse")
	_check(p.arch_cap_uprights, "cfg capUprights")
	_check(p.orientation == "horizontal", "cfg cylinder orientation")
	_feq(p.offset_bot_in, 2.0, 1e-9, "cfg offsets.bottom")
	_feq(p.v_stack_gap, 0.45, 1e-9, "cfg vStackGap")
	_feq(p.bracket_hole_distance, 2.69, 1e-9, "cfg holeDistance")
	_feq(p.bolt_diameter, 0.5, 1e-9, "cfg boltDiameter")
	_feq(rad_to_deg(p.fold_angle), 134.9, 1e-6, "cfg foldAngle deg")
	_check(p.show_bolts, "cfg visibility bolts")
	_feq(float(p.support_beams["offset_h"]), -46.5, 1e-9, "cfg supportBeams offsetH")

	# Full to_config -> from_config round-trip through JSON stringify.
	p.orientation = "vertical"
	p.arch_rotation = 15.0
	p.array_count = 3
	p.min_fold_angle_deg = 12.0
	p.solar_panels["enabled"] = true
	p.solar_panels["layout_mode"] = "spiral"
	(p.solar_panels["top_panels"] as Dictionary)["rated_watts"] = 410.0
	var json_text := JSON.stringify(p.to_config())
	var parsed: Dictionary = JSON.parse_string(json_text)
	var q := LinkageParams.new()
	q.from_config(parsed)
	_check(q.modules == p.modules, "rt modules")
	_feq(q.pivot_pct, p.pivot_pct, 1e-9, "rt pivot_pct")
	_check(q.orientation == "vertical", "rt orientation")
	_feq(q.arch_rotation, 15.0, 1e-9, "rt arch_rotation")
	_check(q.array_count == 3, "rt array_count")
	_feq(q.min_fold_angle_deg, 12.0, 1e-9, "rt min_fold_angle")
	_feq(q.fold_angle, p.fold_angle, 1e-9, "rt fold_angle")
	_check(bool(q.solar_panels["enabled"]), "rt panels enabled")
	_check(str(q.solar_panels["layout_mode"]) == "spiral", "rt layout_mode")
	_feq(float((q.solar_panels["top_panels"] as Dictionary)["rated_watts"]), 410.0, 1e-9, "rt rated_watts")
	_feq(float(q.support_beams["offset_h"]), -46.5, 1e-9, "rt supportBeams offsetH")
	_check(q.v_stack_reverse == p.v_stack_reverse, "rt v_stack_reverse")

	# Auto bolt-length formulas (pure port of beam-bolt-helpers).
	var d := _default_params()
	_feq(d.auto_v_stack_bolt_length(), 3 * 1.5 + 1.0, 1e-9, "auto v bolt len")
	_feq(d.auto_v_stack_inner_bolt_length(), 2 * 1.5 + 1.0, 1e-9, "auto v inner bolt len")
	_feq(d.auto_v_stack_outer_bolt_length(), 1 * 1.5 + 1.0, 1e-9, "auto v outer bolt len")
	_feq(d.auto_h_stack_bolt_length(), 2 * 1.5 + 1.0, 1e-9, "auto h bolt len")
	_feq(d.auto_h_pivot_bolt_length(), 3.0 + 0.25 + 1.0, 1e-9, "auto h pivot bolt len")
	_check(d.needs_split_v_bolts(), "split v bolts for stack=3")


# ---------------------------------------------------------------------------
# Support beams + panel layouts (Phase 4) — invariant checks
# (linkage-geometry.js cannot run standalone under node — it imports the
# renderer — so these pin structural invariants derived from the JS source
# instead of numeric reference dumps.)
# ---------------------------------------------------------------------------

const CLOSED8 := 2.363175807


func _test_canopy_and_module_frames() -> void:
	var p := _default_params()
	var frame := LinkageSolver.solve(p, CLOSED8)

	var canopy := LinkageGeometry.canopy_area(frame)
	_check(not canopy.is_empty(), "canopy computed")
	var center: Vector3 = canopy["center"]
	_feq(center.y, float(canopy["top_height"]), 1e-6, "canopy center at top height")
	_check(float(canopy["top_height"]) > 80.0, "canopy top height plausible")
	# Top ring shares the bottom ring's visible extents -> maxRadius ~= frame
	# maxRad (both measured from the world origin, as in the JS).
	_feq(float(canopy["max_radius"]), float(frame["max_rad"]), 5.0, "canopy max radius ~ frame maxRad")
	_check(float(canopy["area"]) > 100.0, "canopy area positive")
	_check(int(canopy["vertex_count"]) >= 8, "canopy has ring vertices")

	var frames := LinkageGeometry.extract_module_frames(frame, p)
	_check(frames.size() == 8, "module frames = 8")
	if frames.size() < 8:
		return
	# getSupportBeamPlaneY: topBeamY + hStackThick + thickness/2 + offsetV.
	var top_beam: Dictionary = frames[0]["top_beam"]
	var beam_y := ((top_beam["p1"] as Vector3).y + (top_beam["p2"] as Vector3).y) * 0.5
	var expected_y := beam_y + 3.0 + 3.5 / 2.0 + (-6.8)
	_feq(float(frames[0]["support_y"]), expected_y, 1e-4, "support plane Y formula")
	# Closed symmetric ring: every module shares support Y + hinge radius.
	# NOTE the ring is NOT centered on the world origin (module chaining starts
	# there) — radii are relative to the structure center the extractor found.
	var scx := float(frames[0]["structure_cx"])
	var scz := float(frames[0]["structure_cz"])
	var hinge0: Vector3 = frames[0]["hinge_point"]
	var hinge_r0 := Vector2(hinge0.x - scx, hinge0.z - scz).length()
	for i in range(1, 8):
		_feq(float(frames[i]["support_y"]), expected_y, 1e-3, "support Y module %d" % i)
		var h: Vector3 = frames[i]["hinge_point"]
		_feq(Vector2(h.x - scx, h.z - scz).length(), hinge_r0, 0.35, "hinge radius module %d" % i)
	# in_dir unit vectors; h_center inside the ring.
	_feq((frames[0]["in_dir"] as Vector2).length(), 1.0, 1e-6, "in_dir unit")
	var hc: Vector3 = frames[0]["h_center"]
	_check(Vector2(hc.x - scx, hc.z - scz).length() < hinge_r0, "h_center inside hinge ring")


func _test_support_beams() -> void:
	var p := _default_params()
	var frame := LinkageSolver.solve(p, CLOSED8)

	# Above both gates (135.4 deg >= 90): 8 radial + 16 reciprocal.
	var sup := LinkageGeometry.support_beams(frame, p, CLOSED8)
	var counts := _beam_type_counts(sup)
	_check(int(counts.get("support-beam", 0)) == 8, "8 radial support beams")
	_check(int(counts.get("support-beam-reciprocal", 0)) == 16, "16 rcp beams (2/module)")

	var radials := sup.filter(func(b): return str(b["stack_type"]) == "support-beam")
	var r0: Dictionary = radials[0]
	_feq((r0["p1"] as Vector3).y, (r0["p2"] as Vector3).y, 1e-5, "radial beam horizontal")
	_feq(((r0["p2"] as Vector3) - (r0["p1"] as Vector3)).length(), 120.0, 1e-4, "radial beam length = cfg")
	_feq(float(r0["w"]), 1.5, 1e-9, "radial width")
	_feq(float(r0["t"]), 3.5, 1e-9, "radial thickness")
	for b in radials:
		_feq((b["p1"] as Vector3).y, (r0["p1"] as Vector3).y, 1e-3, "radial beams share plane")

	var rcps := sup.filter(func(b): return str(b["stack_type"]) == "support-beam-reciprocal")
	var c0: Dictionary = rcps[0]  # module 0 side A
	var c1: Dictionary = rcps[1]  # module 0 side B
	_feq(((c0["p2"] as Vector3) - (c0["p1"] as Vector3)).length(), 96.0, 1e-4, "rcp length = parallelLength")
	_feq((c0["p1"] as Vector3).y, (c0["p2"] as Vector3).y, 1e-5, "rcp beam horizontal")
	# A/B anchors split vertically by parallelVOffset (-1.66): A below B.
	_feq((c0["p1"] as Vector3).y - (c1["p1"] as Vector3).y, -1.66, 1e-3, "rcp A/B vertical offset")
	_check(str(c0["pattern_id"]) == "A" and str(c1["pattern_id"]) == "B", "rcp pattern ids")
	_check(int(c0["stack_id"]) == 8 and int(c1["stack_id"]) == 9, "rcp stack ids offset by module count")

	# End overhang extends the beam past the anchor.
	p.support_beams["rcp_end_offset"] = 12.0
	var sup_oh := LinkageGeometry.support_beams(frame, p, CLOSED8)
	var rcp_oh: Dictionary = sup_oh.filter(func(b): return str(b["stack_type"]) == "support-beam-reciprocal")[0]
	_feq(((rcp_oh["p2"] as Vector3) - (rcp_oh["p1"] as Vector3)).length(), 108.0, 1e-3, "rcp end overhang adds length")
	p.support_beams["rcp_end_offset"] = 0.0

	# Visibility gates: below both -> none; between -> radial only.
	_check(LinkageGeometry.support_beams(frame, p, deg_to_rad(80.0)).is_empty(), "all supports hidden below 90 deg")
	p.rcp_visible_angle = 120.0
	var mid := LinkageGeometry.support_beams(frame, p, deg_to_rad(100.0))
	var mid_counts := _beam_type_counts(mid)
	_check(int(mid_counts.get("support-beam", 0)) == 8 and int(mid_counts.get("support-beam-reciprocal", 0)) == 0,
		"radial visible, rcp gated at 100 deg")
	p.rcp_visible_angle = 90.0

	# Master toggle + arch mode produce nothing.
	p.support_beams["enabled"] = false
	_check(LinkageGeometry.support_beams(frame, p, CLOSED8).is_empty(), "supports off when disabled")
	p.support_beams["enabled"] = true
	var arch_p := _default_params()
	arch_p.orientation = "vertical"
	var arch_frame := LinkageSolver.solve(arch_p, deg_to_rad(120.0))
	_check(LinkageGeometry.support_beams(arch_frame, arch_p, deg_to_rad(120.0)).is_empty(), "no supports in arch mode")


func _test_panel_layouts() -> void:
	var p := _default_params()
	p.solar_panels["enabled"] = true
	var frame := LinkageSolver.solve(p, CLOSED8)
	var canopy := LinkageGeometry.canopy_area(frame)

	# Rectangular 2x2 (defaults): spacing = size + padding, shared plane, normal up.
	var panels := LinkageGeometry.solar_panels(frame, p)
	_check(panels.size() == 4, "rect layout 2x2 = 4 panels")
	if panels.size() == 4:
		var y0 := float(canopy["top_height"]) + 1.5 / 2.0 + 0.5
		for panel in panels:
			_feq((panel["center"] as Vector3).y, y0, 1e-4, "rect panel plane Y")
			_v3eq(panel["axis_y"], Vector3.UP, 1e-6, "rect panel normal up")
		var d01 := ((panels[1]["center"] as Vector3) - (panels[0]["center"] as Vector3)).length()
		_feq(d01, 39.0 + 2.0, 1e-4, "rect col spacing = width + padX")
		var d02 := ((panels[2]["center"] as Vector3) - (panels[0]["center"] as Vector3)).length()
		_feq(d02, 65.0 + 2.0, 1e-4, "rect row spacing = length + padY")
	_feq(LinkageGeometry.total_watts(panels), 1000.0, 1e-6, "rect total watts 4 x 250")

	# Radial ring at explicit radius (measured from the canopy center — the
	# ring is not centered on the world origin).
	p.solar_panels["layout_mode"] = "radial"
	p.solar_panels["radial_offset"] = 100.0
	panels = LinkageGeometry.solar_panels(frame, p)
	_check(panels.size() == 8, "radial layout = radial_count panels")
	var ccenter: Vector3 = canopy["center"]
	for panel in panels:
		var c: Vector3 = panel["center"]
		_feq(Vector2(c.x - ccenter.x, c.z - ccenter.z).length(), 100.0, 0.01, "radial panel at radius")
		_v3eq(panel["axis_y"], Vector3.UP, 1e-6, "radial panel normal up")

	# Spiral: primary + (armCount-1) secondaries per position.
	p.solar_panels["layout_mode"] = "spiral"
	p.solar_panels["radial_count"] = 4
	p.solar_panels["spiral_arm_count"] = 3
	panels = LinkageGeometry.solar_panels(frame, p)
	_check(panels.size() == 12, "spiral 4 x 3 = 12 panels")
	p.solar_panels["spiral_secondary_enabled"] = false
	panels = LinkageGeometry.solar_panels(frame, p)
	_check(panels.size() == 4, "spiral secondaries toggle off")

	# Master enable + top-section enable gates.
	p.solar_panels["enabled"] = false
	_check((LinkageGeometry.solar_panels(frame, p) as Array).is_empty(), "panels off when disabled")
	p.solar_panels["enabled"] = true
	(p.solar_panels["top_panels"] as Dictionary)["enabled"] = false
	_check((LinkageGeometry.solar_panels(frame, p) as Array).is_empty(), "no top panels when section off")


func _test_arch_faces_and_panels() -> void:
	var p := _default_params()
	p.orientation = "vertical"
	p.modules = 6
	p.use_fixed_beams = true   # rigid arch: bypasses the compression gate
	var frame := LinkageSolver.solve(p, deg_to_rad(120.0))

	var faces := LinkageGeometry.arch_wall_faces(frame)
	_check(faces.size() == 12, "arch faces = 2 per module, got %d" % faces.size())
	for face in faces:
		var normal: Vector3 = face["normal"]
		var wa: Vector3 = face["width_axis"]
		var ha: Vector3 = face["height_axis"]
		_feq(normal.length(), 1.0, 1e-5, "face normal unit")
		_feq(absf(normal.dot(wa)), 0.0, 1e-4, "face normal perp width")
		_feq(absf(normal.dot(ha)), 0.0, 1e-4, "face normal perp height")
		_check(float(face["width"]) > 2.0 and float(face["height"]) > 2.0, "face has area")

	p.solar_panels["enabled"] = true
	(p.solar_panels["top_panels"] as Dictionary)["enabled"] = false
	var side: Dictionary = p.solar_panels["side_panels"]
	side["enabled"] = true
	side["grid_rows"] = 1
	side["grid_cols"] = 1
	var panels := LinkageGeometry.solar_panels(frame, p)
	_check(panels.size() == 12, "arch panels 1 per face, got %d" % panels.size())
	if not panels.is_empty():
		# Panel rides its face's normal, lifted off the surface.
		var found_match := false
		for face in faces:
			if ((panels[0]["axis_y"] as Vector3) - (face["normal"] as Vector3)).length() < 1e-4:
				found_match = true
				break
		_check(found_match, "arch panel normal matches a face normal")

	# Per-face toggles: disable the first half.
	var enabled: Array = []
	for i in range(12):
		enabled.append(i >= 6)
	p.solar_panels["arch_wall_faces"] = enabled
	panels = LinkageGeometry.solar_panels(frame, p)
	_check(panels.size() == 6, "arch face toggles halve panels, got %d" % panels.size())
	p.solar_panels["arch_wall_faces"] = []

	# Cylinder mode side-wall faces face radially outward in the XZ plane (the
	# ring axis is Y), NOT the arch's XY plane — regression for the side-panel
	# orientation bug.
	var pc := _default_params()
	pc.orientation = "horizontal"
	pc.modules = 8
	var cframe := LinkageSolver.solve(pc, deg_to_rad(150.0))
	var cfaces := LinkageGeometry.arch_wall_faces(cframe)
	_check(cfaces.size() > 0, "cylinder side faces produced, got %d" % cfaces.size())
	var horizontal_normals := 0
	for face in cfaces:
		var n: Vector3 = face["normal"]
		_feq(n.length(), 1.0, 1e-5, "cyl face normal unit")
		# Outward should lie mostly in XZ (radial), so |n.y| is small.
		if absf(n.y) < 0.5 and Vector2(n.x, n.z).length() > 0.5:
			horizontal_normals += 1
	_check(horizontal_normals == cfaces.size(),
		"cylinder side faces point radially outward (XZ), got %d/%d" % [horizontal_normals, cfaces.size()])


# ---------------------------------------------------------------------------
# Structure builder (Phase 2) — MultiMesh allocation + metric conversion
# ---------------------------------------------------------------------------

func _test_structure_builder() -> void:
	var builder := LinkageStructureBuilder.new()
	root.add_child(builder)
	# Support beams off: this test pins the pure Phase 2 structure (AABB,
	# stable node identity across fold). Phase 4 extras (which reallocate at
	# visibility-gate crossings) are covered by _test_builder_support_panels.
	var base_params := _default_params()
	base_params.support_beams["enabled"] = false
	builder.set_params(base_params)

	var beams_mm := builder.get_node_or_null("Beams") as MultiMeshInstance3D
	_check(beams_mm != null, "builder Beams node exists")
	if beams_mm != null:
		_check(beams_mm.multimesh.instance_count == 56, "builder 56 beam instances")
	# Transform math via the static helpers (MultiMesh transform read-back is a
	# no-op under the headless dummy renderer, so pin the source math instead).
	var frame := builder.last_frame()
	var ground := LinkageStructureBuilder.ground_offset_for_frame(frame)
	_feq(ground, 1.5 * 0.0254, 1e-4, "builder ground offset (hStackThick/2)")
	var xf := LinkageStructureBuilder.beam_transform((frame["beams"] as Array)[0], ground)
	_feq(xf.basis.x.length(), 3.5 * 0.0254, 1e-4, "builder beam0 width m")
	_feq(xf.basis.y.length(), 1.5 * 0.0254, 1e-4, "builder beam0 thickness m")
	var expected_len := (Vector3(-15.214294716, -0.75, 37.096283659) - Vector3(21.213496598, -0.75, -51.723849306)).length()
	_feq(xf.basis.z.length(), expected_len * 0.0254, 5e-4, "builder beam0 length m")
	var expected_center := (Vector3(-15.214294716, -0.75, 37.096283659) + Vector3(21.213496598, -0.75, -51.723849306)) * 0.5 * 0.0254 + Vector3(0, ground, 0)
	_v3eq(xf.origin, expected_center, 5e-4, "builder beam0 center m")
	# Bracket base sits on top of the bottom H stack: bottomY = hStackThick/2 = 1.5in.
	var br_xf := LinkageStructureBuilder.bracket_transform((frame["brackets"] as Array)[0], ground)
	_v3eq(br_xf.origin, Vector3(-14.645110477, 1.5, -35.708469081) * 0.0254 + Vector3(0, ground, 0), 5e-4, "builder bracket0 origin m")

	var brackets_mm := builder.get_node_or_null("Brackets") as MultiMeshInstance3D
	_check(brackets_mm != null and brackets_mm.multimesh.instance_count == 32, "builder 32 bracket instances")
	_check(builder.get_node_or_null("Bolts") == null, "builder no bolts when show_bolts off")

	# Ground seating: lowest beam corner at local Y=0 (cylinder mode: bottom
	# H-stack extends hStackThick/2 = 1.5in below the solver's Y=0).
	var aabb := builder.frame_aabb()
	_feq(aabb.position.y, 0.0, 1e-4, "builder AABB grounded at 0")
	# maxHeight (93.79 in = 2.38 m) is an analytic bound; actual mesh top is a
	# hair lower (vert end offsets run along the diagonal). Sanity range only.
	_check(aabb.size.y > 2.0 and aabb.size.y < 2.5, "builder AABB height plausible (%.3f m)" % aabb.size.y)

	# Fold update keeps counts and instance nodes (no reallocation) and moves
	# the solved frame (compare solver output, since headless MultiMesh reads
	# are dummy no-ops).
	var before_p1: Vector3 = ((builder.last_frame()["beams"] as Array)[20] as Dictionary)["p1"]
	builder.set_fold_angle(deg_to_rad(60.0))
	_check(builder.get_node_or_null("Beams") == beams_mm, "builder node stable across fold")
	_check(beams_mm.multimesh.instance_count == 56, "builder count stable across fold")
	var after_p1: Vector3 = ((builder.last_frame()["beams"] as Array)[20] as Dictionary)["p1"]
	_check(before_p1.distance_to(after_p1) > 0.5, "builder fold moves the solved frame")

	# Toggling bolts on reallocates with bolt instances.
	builder.params.show_bolts = true
	builder.rebuild()
	var bolts_mm := builder.get_node_or_null("Bolts") as MultiMeshInstance3D
	_check(bolts_mm != null and bolts_mm.multimesh.instance_count == 88, "builder 88 bolt instances")
	var heads_mm := builder.get_node_or_null("BoltHeads") as MultiMeshInstance3D
	_check(heads_mm != null and heads_mm.multimesh.instance_count == 176, "builder 176 bolt head instances")

	# Cached closed/min angles match the pinned kinematics values.
	_feq(builder.closed_angle(), 2.363175807, 1e-6, "builder closed angle cache")
	_feq(builder.min_fold_angle(), 0.087266463, 0.002, "builder min fold cache")

	var stats := builder.get_stats()
	_check(int(stats["beam_count"]) == 56, "builder stats beam_count")
	_feq(float(stats["max_height_m"]), float(stats["max_height_in"]) * 0.0254, 1e-6, "builder stats metric height")

	builder.queue_free()


## Builder integration for Phase 4: support/panel MultiMeshes appear above the
## visibility gates, reallocate away below them, and reappear on re-deploy.
func _test_builder_support_panels() -> void:
	var p := _default_params()
	p.solar_panels["enabled"] = true
	var builder := LinkageStructureBuilder.new()
	root.add_child(builder)
	builder.set_params(p)  # default fold 135.4 deg >= all gates

	var sup_mm := builder.get_node_or_null("SupportBeams") as MultiMeshInstance3D
	_check(sup_mm != null and sup_mm.multimesh.instance_count == 24, "builder 24 support instances")
	var pan_mm := builder.get_node_or_null("SolarPanels") as MultiMeshInstance3D
	_check(pan_mm != null and pan_mm.multimesh.instance_count == 4, "builder 4 panel instances")

	var stats := builder.get_stats()
	_check(int(stats["support_beam_count"]) == 24, "builder stats support count")
	_check(int(stats["panel_count"]) == 4, "builder stats panel count")
	_feq(float(stats["panel_watts"]), 1000.0, 1e-6, "builder stats panel watts")

	# Metric panel transform from the static helper (headless MultiMesh reads
	# are dummy no-ops — same approach as _test_structure_builder).
	var ground := LinkageStructureBuilder.ground_offset_for_frame(builder.last_frame())
	var panel0: Dictionary = builder.last_panels()[0]
	var pxf := LinkageStructureBuilder.panel_transform(panel0, ground)
	_feq(pxf.basis.y.length(), 1.5 * 0.0254, 1e-5, "panel transform thickness m")
	_feq(pxf.basis.x.length(), 39.0 * 0.0254, 1e-4, "panel transform width m")
	_feq(pxf.origin.y, (panel0["center"] as Vector3).y * 0.0254 + ground, 1e-5, "panel transform Y m")

	# Folding below the gates strips the extras (count mismatch -> realloc).
	builder.set_fold_angle(deg_to_rad(80.0))
	_check(builder.get_node_or_null("SupportBeams") == null, "supports removed below gate")
	_check(builder.get_node_or_null("SolarPanels") == null, "panels removed below gate")
	_check(builder.last_support_beams().is_empty() and builder.last_panels().is_empty(),
		"builder caches emptied below gate")

	# Deployed summary is fold-state independent (the Phase 6 handoff numbers).
	var summary := builder.deployed_panel_summary()
	_check(int(summary["count"]) == 4, "deployed summary count while stowed")
	_feq(float(summary["watts"]), 1000.0, 1e-6, "deployed summary watts while stowed")

	# Re-deploying brings them back.
	builder.set_fold_angle(builder.closed_angle())
	sup_mm = builder.get_node_or_null("SupportBeams") as MultiMeshInstance3D
	_check(sup_mm != null and sup_mm.multimesh.instance_count == 24, "supports restored on re-deploy")
	pan_mm = builder.get_node_or_null("SolarPanels") as MultiMeshInstance3D
	_check(pan_mm != null and pan_mm.multimesh.instance_count == 4, "panels restored on re-deploy")

	builder.queue_free()


# ---------------------------------------------------------------------------
# World placement (Phase 5) — catalog branch, collision mesh, deploy runtime
# ---------------------------------------------------------------------------

func _test_world_placement_runtime() -> void:
	# Catalog entry + procedural instantiate branch.
	var entry := ModelCatalog.find(LinkageStructureBuilder.MODEL_ID)
	_check(not entry.is_empty() and bool(entry.get("procedural", false)),
		"catalog has procedural linkage entry")
	var cfg := _default_params().to_config()
	var node := ModelCatalog.instantiate(LinkageStructureBuilder.MODEL_ID, {"linkage_spec": cfg})
	var built := node as LinkageStructureBuilder
	_check(built != null, "catalog instantiates LinkageStructureBuilder")
	if built == null:
		return
	_check(built.params.modules == 8, "instantiated spec round-trips modules")
	# Hidden collision mesh: real triangle geometry (PlacedProp collision +
	# pick AABB + mesh_metrics all consume MeshInstance3D faces).
	var cmesh := built.get_node_or_null("CollisionMesh") as MeshInstance3D
	_check(cmesh != null and not cmesh.visible, "collision mesh exists, hidden")
	if cmesh != null:
		var faces := cmesh.mesh.get_faces()
		# 56 beams + 24 support beams, 12 triangles each, 3 verts per tri.
		_check(faces.size() == (56 + 24) * 12 * 3, "collision faces cover beams+supports, got %d" % faces.size())

	# PlacedProp + deploy runtime: fold animates stow<->deploy and rebuilds
	# collision at the settle points.
	var prop := PlacedProp.new()
	prop.prop_id = "test_linkage"
	prop.model_id = LinkageStructureBuilder.MODEL_ID
	prop.add_child(built)
	built.name = "ModelRoot"
	root.add_child(prop)
	prop.setup_collision()
	_check(prop.get_node_or_null("PropBody") != null, "prop builds a collision body")
	# Local pick AABB (global_transform is unavailable until the --script tree
	# starts iterating, so query the prop-local box directly).
	_check((prop.get("_pick_aabb_local") as AABB).size.y > 1.0, "prop pick AABB has volume")

	var deploy := LinkageDeployRuntime.new()
	deploy.name = "LinkageDeployRuntime"
	deploy.configure({"linkage_fold_deg": 30.0})
	prop.add_child(deploy)
	if deploy.get("_builder") == null:
		deploy.call("_ready")   # --script mode: NOTIFICATION_READY not delivered
	_feq(rad_to_deg(built.get_fold_angle()), 30.0, 0.01, "runtime restores persisted fold")
	_check(not deploy.is_deployed(), "runtime stowed at 30 deg")

	deploy.toggle_deploy()
	_check(deploy.is_animating(), "deploy animation started")
	var before := built.get_fold_angle()
	deploy._process(0.5)
	_check(built.get_fold_angle() > before, "deploy fold expanding")
	for i in range(20):   # 20 x 0.5 s >> 3 s full cycle
		deploy._process(0.5)
	_check(not deploy.is_animating(), "deploy animation settled")
	_check(deploy.is_deployed(), "runtime deployed at closed angle")
	_feq(built.get_fold_angle(), built.closed_angle(), 1e-4, "deploy lands exactly on closed angle")

	deploy.toggle_deploy()
	for i in range(20):
		deploy._process(0.5)
	_check(not deploy.is_deployed(), "runtime stows back down")
	_feq(built.get_fold_angle(), built.min_fold_angle(), 1e-4, "stow lands on min fold angle")

	prop.free()


# ---------------------------------------------------------------------------
# Solar/graph handoff (Phase 6) — deployed summary + normal->orientation
# ---------------------------------------------------------------------------

func _test_solar_handoff() -> void:
	# orientation_from_normal: compass azimuth uses CelestialClock's convention
	# (north = -Z, east = +X, clockwise). Flat-up = tilt 0.
	var flat := LinkageStructureBuilder.orientation_from_normal(Vector3.UP)
	_feq(float(flat["tilt_deg"]), 0.0, 1e-4, "flat panel tilt 0")
	# Normal leaning toward +X (east) => azimuth 90, tilt 45.
	var east := LinkageStructureBuilder.orientation_from_normal(Vector3(1, 1, 0))
	_feq(float(east["tilt_deg"]), 45.0, 1e-3, "east-leaning tilt 45")
	_feq(float(east["azimuth_deg"]), 90.0, 1e-3, "east-leaning azimuth 90")
	# Normal leaning toward -Z (north) => azimuth 0.
	var north := LinkageStructureBuilder.orientation_from_normal(Vector3(0, 1, -1))
	_feq(float(north["azimuth_deg"]), 0.0, 1e-3, "north-leaning azimuth 0")
	# Normal leaning toward +Z (south) => azimuth 180.
	var south := LinkageStructureBuilder.orientation_from_normal(Vector3(0, 1, 1))
	_feq(float(south["azimuth_deg"]), 180.0, 1e-3, "south-leaning azimuth 180")

	# deployed_panel_summary carries per-panel watts, unit avg normal, and the
	# active section's electrical specs — the numbers the graph seeder pushes.
	var p := _default_params()
	p.solar_panels["enabled"] = true
	(p.solar_panels["top_panels"] as Dictionary)["enabled"] = true
	var builder := LinkageStructureBuilder.new()
	root.add_child(builder)
	builder.set_params(p)
	var summary := builder.deployed_panel_summary()
	_check(int(summary["count"]) > 0, "deployed summary has panels")
	if int(summary["count"]) > 0:
		_feq(float(summary["watts_per_panel"]) * int(summary["count"]),
			float(summary["watts"]), 1e-3, "watts_per_panel x count = total")
		_feq((summary["avg_normal"] as Vector3).length(), 1.0, 1e-4,
			"avg normal is unit length")
		var top: Dictionary = p.solar_panels["top_panels"]
		_feq(float(summary["voc"]), float(top["voc"]), 1e-6, "summary voc from top section")
		_check(float(summary["panel_w_m"]) > 0.0, "summary panel width in metres")
	builder.queue_free()


# ---------------------------------------------------------------------------
# Designer modal (Phase 3) — compile smoke + shipped presets
# ---------------------------------------------------------------------------

## Force-compile the lazily-loaded modal script (no class_name → not parsed at
## import) so GDScript errors surface offline. Requires _initialize (not
## _init) — autoload identifiers like CursorController only resolve once the
## autoloads have registered.
func _test_modal_script_compiles() -> void:
	var modal_script: Script = load("res://scenes/ui/linkage_lab_modal.gd")
	_check(modal_script != null, "modal script loads")
	if modal_script == null:
		return
	_check(modal_script.can_instantiate(), "modal can_instantiate")
	var inst := Control.new()
	inst.set_script(modal_script)
	_check(inst.has_method("open"), "modal has open")
	_check(inst.has_method("close"), "modal has close")
	_check(inst.has_method("bind_loader"), "modal has bind_loader")
	inst.free()

	# Functional smoke: build the full UI + studio world headless, apply the
	# default params, drive the fold slider (no-rebuild path), load the first
	# shipped preset, and step the fold animation once.
	var modal := Control.new()
	modal.set_script(modal_script)
	root.add_child(modal)
	if modal.get("_builder") == null:
		# --script SceneTree doesn't deliver NOTIFICATION_READY here; build
		# the UI explicitly so the smoke exercises the real construction path.
		modal.call("_ready")
	modal.call("_apply_params", true)
	modal.call("_sync_controls")
	var builder = modal.get("_builder")
	_check(builder != null and not (builder.last_frame() as Dictionary).is_empty(),
		"modal builder solved a frame")
	modal.call("_on_fold_slider", 90.0)
	_feq(rad_to_deg(float(modal.get("params").fold_angle)), 90.0, 0.01, "modal fold slider drives angle")
	var presets: Array = modal.get("_presets")
	_check(presets.size() >= 3, "modal scanned shipped presets")
	if not presets.is_empty():
		modal.call("_on_preset_selected", 1)
		_check(int(modal.get("params").modules) >= 3, "modal preset applied")
	# Fold down first so a one-shot UNFOLD has room to travel (a preset loads
	# at its deployed angle, where unfold completes instantly).
	modal.call("_on_fold_slider", 30.0)
	modal.call("_on_unfold_btn")
	var before := float(modal.get("params").fold_angle)
	modal.call("_step_animation", 0.1)
	_check(bool(modal.get("_anim_playing")), "modal animation stepping")
	_check(float(modal.get("params").fold_angle) > before, "modal animation expands fold")
	modal.free()


## Every shipped preset must parse as v30 and solve without breaking counts.
func _test_shipped_presets() -> void:
	var d := DirAccess.open("res://core/linkage/presets/")
	_check(d != null, "presets dir exists")
	if d == null:
		return
	var count := 0
	for fname in d.get_files():
		if not fname.ends_with(".json"):
			continue
		count += 1
		var f := FileAccess.open("res://core/linkage/presets/" + fname, FileAccess.READ)
		var parsed = JSON.parse_string(f.get_as_text())
		_check(parsed is Dictionary, "preset %s parses" % fname)
		if not (parsed is Dictionary):
			continue
		var p := LinkageParams.new()
		p.from_config(parsed as Dictionary)
		_check(p.modules >= 3 and p.modules <= 40, "preset %s modules sane" % fname)
		var frame := LinkageSolver.solve(p, p.fold_angle)
		_check((frame["beams"] as Array).size() > 0, "preset %s solves beams" % fname)
		_check(float(frame["max_rad"]) > 1.0, "preset %s has radius" % fname)
	_check(count >= 3, "at least 3 shipped presets")
