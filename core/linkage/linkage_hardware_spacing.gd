class_name LinkageHardwareSpacing
extends RefCounted
## The single choke point where high-detail hardware takes over the structure's
## stack gaps and bracket dimensions.
##
## Port of `js/linkage/hw-structure-spacing.js:hwResolveStructureSpacing`. When
## "Hardware Full Detail" is on, the physical parts decide how far apart the
## beams sit — the centre-slot washers ARE the gap — instead of the sidebar's
## abstract numbers. When it is off, nothing changes at all.
##
## [b]Why this is one function and not a dozen patched read sites.[/b]
## `LinkageSolver.solve` reads `v_stack_gap` / `h_stack_gap` / the bracket
## fields both directly and transitively, through helpers like
## `LinkageParams.v_stack_beam_center_offset()` and `auto_h_pivot_bolt_length()`.
## Patching each read site would mean finding every one of them and never
## missing one again. Instead `effective_params` substitutes a whole
## LinkageParams up front, and the solver's 780 lines are untouched.
##
## [b]Why the identity return matters.[/b] With full detail OFF this returns
## `p` ITSELF — the same object, not a copy with equal values. The solver's 349
## pinned reference values were generated by running the real JS app with the
## hardware globals mocked to false (`tools/linkage_reference.mjs`), so the
## flag-off path must be bit-identical to the pre-hardware port. Returning the
## same object makes that true by construction rather than by inspection, and
## the selftest asserts it with `is_same()`, not value equality.

## Fields this class may override, for the UI to grey out.
const OVERRIDDEN_FIELDS: PackedStringArray = [
	"v_stack_gap", "h_stack_gap",
	"bracket_width", "bracket_depth", "bracket_height",
	"bracket_wall_thickness", "bracket_inner_width",
	"bracket_hole_diameter", "bracket_hole_distance",
]

static var _cache: LinkageParams = null
static var _cache_key := ""


## Resolved spacing when full detail owns it, or `{}` when the sidebar values
## still apply. Shape: `{v_stack_gap, h_stack_gap, bracket: {} | {...}}`.
static func resolve(p: LinkageParams) -> Dictionary:
	if not p.show_hardware_full_detail:
		return {}
	var bracket := effective_bracket_params(p)
	if not is_active(p):
		return {}
	return {
		"v_stack_gap": effective_v_stack_gap(p),
		"h_stack_gap": effective_h_stack_gap(p),
		"bracket": bracket,
	}


## True when the assemblies are actually driving spacing, so the UI knows to
## dim the sidebar inputs (`hwIsDetailStructureSpacingActive`).
static func is_active(p: LinkageParams) -> bool:
	if not p.show_hardware_full_detail:
		return false
	if LinkageHardware.use_full_detail(p):
		return true
	var ha: Dictionary = p.hardware_assemblies
	return LinkageHardware.assembly_has_parts(ha, "vCenter") \
		or LinkageHardware.assembly_has_parts(ha, "hCenter")


static func overridden_field_names() -> PackedStringArray:
	return OVERRIDDEN_FIELDS


# ---------------------------------------------------------------------------
# THE choke point
# ---------------------------------------------------------------------------

## The parameters the solver should actually use.
##
## Returns `p` itself whenever hardware detail is not driving spacing — see the
## class docs. Otherwise returns a cached copy with the resolved gaps and
## bracket dimensions substituted in, and the flag cleared so the function is a
## fixed point (`effective_params(effective_params(p))` is the same object).
static func effective_params(p: LinkageParams) -> LinkageParams:
	if p == null or not p.show_hardware_full_detail:
		return p
	var sp := resolve(p)
	if sp.is_empty():
		return p
	var key := _key_for(p)
	if key == _cache_key and _cache != null:
		return _cache
	var q := p.duplicate_params()
	# Clearing the flag is what makes this a fixed point: the copy resolves to
	# itself, so a nested solve can never re-derive spacing from spacing.
	q.show_hardware_full_detail = false
	q.v_stack_gap = float(sp["v_stack_gap"])
	q.h_stack_gap = float(sp["h_stack_gap"])
	var br: Dictionary = sp.get("bracket", {})
	if not br.is_empty():
		q.bracket_width = float(br["width"])
		q.bracket_depth = float(br["depth"])
		q.bracket_height = float(br["height"])
		q.bracket_wall_thickness = float(br["wall_thickness"])
		q.bracket_inner_width = float(br["inner_width"])
		q.bracket_hole_diameter = float(br["hole_diameter"])
		q.bracket_hole_distance = float(br["hole_distance"])
	_cache = q
	_cache_key = key
	return q


## Cache key: the WHOLE config, not just the spacing inputs.
##
## The cached object is a full duplicate of `p`, so every field it carries was
## baked at cache-build time. A key covering only the spacing inputs let any
## OTHER change ride a stale hit — the concrete casualty was the hardware
## modal: its display solve (brackets/bolts hidden) primed the cache, its
## placement solve (flags on) got the flags-off copy back, and every placement
## vanished. `to_config()` hashes everything the duplicate reproduces,
## including the assembly graph, and the Lab already pays this exact cost per
## fold tick in `packed_spec()`.
static func _key_for(p: LinkageParams) -> String:
	return str(p.to_config().hash())


## Test hook — the cache is keyed on content, but a suite that mutates an
## assembly in place can defeat that.
static func clear_cache() -> void:
	_cache = null
	_cache_key = ""


# ---------------------------------------------------------------------------
# Resolution rules (hw-structure-spacing.js)
# ---------------------------------------------------------------------------

## Gap between vertical beams. The vCenter assembly's sandwich span covers the
## whole stack, so one gap is that span shared across the (n-1) interfaces.
static func effective_v_stack_gap(p: LinkageParams) -> float:
	if not p.show_hardware_full_detail:
		return p.v_stack_gap
	var n := p.v_stack_count
	if n <= 1:
		return 0.0
	if LinkageHardware.assembly_has_parts(p.hardware_assemblies, "vCenter"):
		var gap := _gap_from_assembly(
			LinkageHardware.assembly(p.hardware_assemblies, "vCenter"), n)
		if not is_nan(gap):
			return gap
	return p.v_stack_gap


## Gap between horizontal beams: hCenter if it is populated, else the outer
## V-beam assembly (whose H-beam sandwich is the same physical joint).
static func effective_h_stack_gap(p: LinkageParams) -> float:
	if not p.show_hardware_full_detail:
		return p.h_stack_gap
	var n := p.h_stack_count
	if n <= 1:
		return 0.0
	var ha: Dictionary = p.hardware_assemblies
	if LinkageHardware.assembly_has_parts(ha, "hCenter"):
		var gap := _gap_from_assembly(LinkageHardware.assembly(ha, "hCenter"), n)
		if not is_nan(gap):
			return gap
	if LinkageHardware.use_full_detail(p):
		var gap2 := _gap_from_assembly(LinkageHardware.assembly(ha, "outerVBeam"), n)
		if not is_nan(gap2):
			return gap2
	return p.h_stack_gap


## One interface's share of an assembly's sandwich span. NAN means "this
## assembly has nothing to say", so the caller falls back.
static func _gap_from_assembly(asm: Dictionary, stack_count: int) -> float:
	if asm.is_empty() or (asm.get("parts", []) as Array).is_empty():
		return NAN
	var span := LinkageHwLayout.assembly_sandwich_gap(asm)
	if span <= 0.0 or stack_count <= 1:
		return NAN
	return span / float(stack_count - 1)


## Bracket dimensions taken from the outer V-beam assembly's actual bracket
## part, or `{}` to keep the sidebar values (`hwGetEffectiveBracketParams`).
static func effective_bracket_params(p: LinkageParams) -> Dictionary:
	if not LinkageHardware.use_full_detail(p):
		return {}
	var bracket := LinkageHardware.bracket_part(
		LinkageHardware.assembly(p.hardware_assemblies, "outerVBeam"))
	if bracket.is_empty() or not (bracket.get("params") is Dictionary):
		return {}
	var bp: Dictionary = bracket["params"]
	var height := _num(bp, "height", p.bracket_height)
	var wall := _num(bp, "wallThickness", p.bracket_wall_thickness)
	var width := _num(bp, "width", p.bracket_width)
	var from_top := _num(bp, "sideHoleFromTop", 1.1875)
	return {
		"width": width,
		"depth": _num(bp, "depth", p.bracket_depth),
		"height": height,
		"wall_thickness": wall,
		"hole_diameter": _num(bp, "holeDiameter", p.bracket_hole_diameter),
		# The sidebar measures the hole UP from the base; the part measures it
		# DOWN from the top. Same hole, opposite datum.
		"hole_distance": height - from_top,
		"inner_width": _num(bp, "innerWidth", maxf(0.25, width - 2.0 * wall)),
	}


static func _num(d: Dictionary, key: String, fallback: float) -> float:
	var v = d.get(key)
	if v is float or v is int:
		return float(v)
	return fallback
