class_name DomeLabZome
extends RefCounted

## Zomes: polar zonohedra (Baer's zomes, Bell's plywood zomes) and their
## helix form. Pure static geometry, the same output shape as
## DomeLabGeodesic.build so everything downstream is shared.
##
## A polar zonohedron of order n (Chilton & Coxeter 1963; Towle 1996) is
## generated by n vectors g_j of equal length on one cone — polar angle θ
## from the axis, azimuths 2πj/n. Its vertices are the sums of RUNS of
## consecutive generators, V(i, k) = Σ_{j=i}^{i+k−1} g_j (k = 0 the apex,
## k = n the bottom point), and its faces are the n(n−1) rhombi
##   R(i, k) = [V(i,k), V(i,k+1), V(i−1,k+2), V(i−1,k+1)],  k = 0 … n−2,
## each spanned by g_{i+k} and g_{i−1}. Every edge is a translate of one
## generator, so a zome has ONE strut length and n−1 rhombus shapes — the
## whole point of building one.
##
## A zome dome keeps layers 0 … K: the ring V(·, K) is level (constant θ) and
## is the floor. "cut" trims the rhombi of row K−1 at that plane into the
## triangles [V(i,K−1), V(i,K), V(i−1,K)] — Bell's half-rhombus base;
## "zigzag" keeps the whole rhombi.
##
## Every edge belongs to a RIB: edges V(i,k)→V(i,k+1) (fixed i) chain into a
## right-handed helix R_i from apex to floor; edges V(i,k)→V(i−1,k+1)
## (fixed i+k) into a left-handed L_m. Through the nodes of rib R_i runs the
## smooth curve
##   r(k) = L sinθ · sin(kπ/n) / sin(π/n),  ψ(k) = φ_i + (k−1)π/n,  y(k) = kL cosθ,
## which is exactly the polar zonohedron's infinite-frequency limit — the
## "helix zome" of n double helices (simplydifferently.org/Helix_Zome; its
## x,y = (d/4)(sin(α+β) + sin β, …) is this curve with α = 2kπ/n). The ribs
## option builds the structure from those continuous curved ribs, lapped
## where a right rib crosses a left one, instead of straight struts.
##
## Size: the widest ring is k = n/2 at radius L sinθ / sin(π/n), so
## L = R sin(π/n) / sinθ puts the widest ring at `radius`.


static func build(z: Dictionary, radius: float = 1.0) -> Dictionary:
	var n := clampi(int(z.get("sides", 8)), 3, 16)
	var K := clampi(int(z.get("layers", 4)), 1, n)
	var theta := deg_to_rad(clampf(float(z.get("pitch_deg", 40.0)), 10.0, 80.0))
	var base_mode := str(z.get("base", "cut"))
	var triangulate := bool(z.get("triangulate", false))
	var stretch := float(z.get("stretch", 1.0))
	var L := radius * sin(PI / n) / sin(theta)
	var gens: Array = []
	for j in n:
		var phi := TAU * j / n
		gens.append(Vector3(sin(theta) * sin(phi), cos(theta), sin(theta) * cos(phi)) * L)
	# Every vertex of the full zonohedron (k = 0 … n), ids by (i, k).
	var ids := {}
	var verts := PackedVector3Array()
	var apex_id := -1
	var bottom_id := -1
	var all_faces: Array = []   # for the full-surface normals
	for k in range(0, n + 1):
		for i in n:
			if k == 0:
				if apex_id < 0:
					apex_id = verts.size()
					verts.append(Vector3.ZERO)
				ids[Vector2i(i, 0)] = apex_id
			elif k == n:
				if bottom_id < 0:
					var s := Vector3.ZERO
					for gg in gens:
						s += gg
					bottom_id = verts.size()
					verts.append(s)
				ids[Vector2i(i, n)] = bottom_id
			else:
				var s := Vector3.ZERO
				for j in k:
					s += gens[(i + j) % n]
				ids[Vector2i(i, k)] = verts.size()
				verts.append(s)
	var rhombus := func(i: int, k: int) -> PackedInt32Array:
		return PackedInt32Array([int(ids[Vector2i(i, k)]), int(ids[Vector2i(i, k + 1)]),
			int(ids[Vector2i(posmod(i - 1, n), k + 2)]), int(ids[Vector2i(posmod(i - 1, n), k + 1)])])
	for k in range(0, n - 1):
		for i in n:
			all_faces.append(rhombus.call(i, k))
	# Stretch and the full-surface normals (before the cut).
	for i in verts.size():
		verts[i] = Vector3(verts[i].x, verts[i].y * stretch, verts[i].z)
	var normals := DomeLabGeodesic._vertex_normals(verts, all_faces)
	# The apex of a zome points UP: flip the structure so k = 0 is the top.
	var top_y := 0.0
	for v in verts:
		top_y = maxf(top_y, v.y)
	# Faces kept for the dome.
	var faces: Array = []
	var edge_tag := {}
	var tag_edge := func(a: int, b: int, fam: String, idx: int) -> void:
		edge_tag[DomeLabGeodesic._ekey(a, b)] = {"rib": fam, "index": idx}
	var rows := K - 1 if base_mode == "cut" else K
	rows = clampi(rows, 0, n - 1)
	for k in rows:
		for i in n:
			var q: PackedInt32Array = rhombus.call(i, k)
			if triangulate:
				# Short diagonal: V(i,k+1)–V(i-1,k+1) for the upper half (k small).
				var d_a := verts[q[1]].distance_to(verts[q[3]])
				var d_b := verts[q[0]].distance_to(verts[q[2]])
				if d_a <= d_b:
					faces.append(PackedInt32Array([q[0], q[1], q[3]]))
					faces.append(PackedInt32Array([q[1], q[2], q[3]]))
					tag_edge.call(q[1], q[3], "diag", k)
				else:
					faces.append(PackedInt32Array([q[0], q[1], q[2]]))
					faces.append(PackedInt32Array([q[0], q[2], q[3]]))
					tag_edge.call(q[0], q[2], "diag", k)
			else:
				faces.append(q)
			tag_edge.call(q[0], q[1], "R", i)
			tag_edge.call(q[3], q[2], "R", posmod(i - 1, n))
			tag_edge.call(q[0], q[3], "L", posmod(i + k, n))
			tag_edge.call(q[1], q[2], "L", posmod(i + k + 1, n))
	var base_ids: Array = []
	if base_mode == "cut" and K >= 1:
		var kk := K - 1
		for i in n:
			var a := int(ids[Vector2i(i, kk)])
			var b := int(ids[Vector2i(i, K)])
			var c := int(ids[Vector2i(posmod(i - 1, n), K)])
			if K == n:
				continue
			faces.append(PackedInt32Array([a, b, c]))
			tag_edge.call(a, b, "R", i)
			tag_edge.call(a, c, "L", posmod(i + kk, n))
			tag_edge.call(b, c, "base", i)
		for i in n:
			var bid := int(ids[Vector2i(i, K)])
			if not base_ids.has(bid):
				base_ids.append(bid)
	else:
		for i in n:
			for kk in [K, K + 1]:
				if kk > n:
					continue
				var bid := int(ids[Vector2i(i, kk)])
				if not base_ids.has(bid):
					base_ids.append(bid)
	if K >= n:
		base_ids = [bottom_id]
	# Compact, flip upright (apex at the top), stand on the floor.
	var used := {}
	for f in faces:
		for id in (f as PackedInt32Array):
			used[int(id)] = true
	var remap := PackedInt32Array()
	remap.resize(verts.size())
	var v2 := PackedVector3Array()
	var n2 := PackedVector3Array()
	var ribs := {}   # new id → (i, k) for the rib curves
	var inv := {}
	for key in ids:
		inv[int(ids[key])] = key
	for i in verts.size():
		if used.has(i):
			remap[i] = v2.size()
			var v := verts[i]
			v2.append(Vector3(v.x, top_y - v.y, v.z))
			var nn := normals[i]
			n2.append(Vector3(nn.x, -nn.y, nn.z))
			if inv.has(i):
				ribs[v2.size() - 1] = inv[i]
		else:
			remap[i] = -1
	var f2: Array = []
	for f in faces:
		var pf: PackedInt32Array = f
		var out := PackedInt32Array()
		for id in pf:
			out.append(remap[id])
		# Outward orientation after the flip (the mirror reversed it).
		var c := Vector3.ZERO
		for id in out:
			c += v2[id]
		c /= out.size()
		var nrm := (v2[out[1]] - v2[out[0]]).cross(v2[out[2]] - v2[out[0]])
		var axis_pt := Vector3(0, c.y, 0)
		if nrm.dot(c - axis_pt) < 0.0:
			out.reverse()
		f2.append(out)
	var tags2 := {}
	for key in edge_tag:
		var parts := str(key).split("_")
		var a := remap[int(parts[0])]
		var b := remap[int(parts[1])]
		if a >= 0 and b >= 0:
			tags2[DomeLabGeodesic._ekey(a, b)] = edge_tag[key]
	var min_y := INF
	for v in v2:
		min_y = minf(min_y, v.y)
	for i in v2.size():
		v2[i] = Vector3(v2[i].x, v2[i].y - min_y, v2[i].z)
	var base2: Array = []
	for id in base_ids:
		if remap[int(id)] >= 0:
			base2.append(remap[int(id)])
	var edges := DomeLabGeodesic._edges_of(f2)
	return {"verts": v2, "faces": f2, "edges": edges, "base_ids": base2, "normals": n2,
		"full_count": {"v": verts.size(), "e": n * (n - 1) * 2, "f": n * (n - 1)},
		"rings": [], "cut_ring": K, "fraction_actual": float(K) / float(n), "warnings": [],
		"centre": Vector3(0, top_y * 0.5 - min_y, 0), "edge_tags": tags2, "rib_index": ribs,
		"gen_len_m": L, "sides": n, "layers": K, "theta": theta, "stretch": stretch,
		"top_y": top_y - min_y}


## A point on the smooth rib through the nodes of rib (fam, index) at the
## continuous layer k, in the OUTPUT frame (apex up, floor at y = 0).
static func rib_point(geo: Dictionary, fam: String, index: int, k: float) -> Vector3:
	var n := int(geo["sides"])
	var L := float(geo["gen_len_m"])
	var theta := float(geo["theta"])
	var r := L * sin(theta) * sin(k * PI / n) / sin(PI / n)
	var psi := 0.0
	if fam == "R":
		psi = TAU * index / n + (k - 1.0) * PI / n
	else:
		psi = TAU * index / n - PI / n - k * PI / n
	var y_full := k * L * cos(theta) * float(geo["stretch"])
	var y := float(geo["top_y"]) - y_full
	return Vector3(r * sin(psi), y, r * cos(psi))


## Arc length of a rib between layers k0 and k1 (numerical).
static func rib_arc_length(geo: Dictionary, fam: String, index: int, k0: float, k1: float,
		steps: int = 24) -> float:
	var s := 0.0
	var prev := rib_point(geo, fam, index, k0)
	for i in range(1, steps + 1):
		var k := lerpf(k0, k1, float(i) / steps)
		var p := rib_point(geo, fam, index, k)
		s += prev.distance_to(p)
		prev = p
	return s
