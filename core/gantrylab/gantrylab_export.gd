class_name GantryLabExport
extends RefCounted

## What leaves the designer as files: a Klipper printer.cfg, Marlin
## Configuration.h defines, grbl $-settings, the BOM CSV, the cut list, the
## design JSON. The firmware files carry the SAME numbers the simulation
## ran on (steps/mm, kinematics, limits), so a real machine built from the
## BOM starts from a config that matches what was watched here.


static func klipper_cfg(d: Dictionary) -> String:
	var s: Dictionary = d["spec"]
	var kin := str(s["kinematics"])
	var e: Dictionary = s["electronics"]
	var v: Dictionary = s["volume"]
	var tool := GantryLabParts.tool(str(s["tool"]["id"]))
	var lines: Array = []
	lines.append("# %s — generated by the SIMbiogenesis gantry lab" % str(s["name"]))
	lines.append("# %s" % GantryLabSpec.describe(s))
	lines.append("")
	lines.append("[printer]")
	var kk := {"bedslinger": "cartesian", "cartesian_xy": "cartesian", "corexy": "corexy", "corexz": "corexz",
		"hbot": "hybrid_corexy", "delta": "delta", "router": "cartesian"}
	lines.append("kinematics: %s" % str(kk.get(kin, "cartesian")))
	lines.append("max_velocity: %.0f" % float(e["max_feed_mm_s"]))
	lines.append("max_accel: %.0f" % float(e["accel_mm_s2"]))
	if kin != "delta":
		lines.append("max_z_velocity: %.0f" % minf(float(e["max_feed_mm_s"]), 30.0 if str(s["axis"]["z"]["drive"]).begins_with("lead") else 100.0))
		lines.append("max_z_accel: %.0f" % minf(float(e["accel_mm_s2"]), 500.0))
	lines.append("square_corner_velocity: %.1f" % float(e["junction_mm_s"]))
	if kin == "delta":
		var r := GantryLabKinematics.delta_reach(s)
		lines.append("delta_radius: %.2f" % float(r["delta_radius_mm"]))
		lines.append("print_radius: %.0f" % (float(v["x_mm"]) * 0.5))
	lines.append("")
	var axes := _klipper_axes(kin)
	for ax in axes:
		var key := str(ax["key"])
		var name := str(ax["name"])
		var a: Dictionary = s["axis"][key]
		lines.append("[%s]" % name)
		lines.append("step_pin: PIN_%s_STEP" % name.to_upper())
		lines.append("dir_pin: PIN_%s_DIR" % name.to_upper())
		lines.append("enable_pin: !PIN_%s_EN" % name.to_upper())
		lines.append("microsteps: %d" % int(a["microsteps"]))
		lines.append("rotation_distance: %.3f" % GantryLabKinematics.mm_per_rev(a))
		if int(GantryLabParts.motor(str(a["motor"]))["steps"]) != 200:
			lines.append("full_steps_per_rotation: %d" % int(GantryLabParts.motor(str(a["motor"]))["steps"]))
		lines.append("endstop_pin: ^PIN_%s_STOP" % name.to_upper())
		if kin == "delta":
			lines.append("arm_length: %.1f" % float(s["delta"]["arm_mm"]))
			lines.append("position_endstop: %.1f" % (float(v["z_mm"]) + float(GantryLabKinematics.delta_reach(s)["h_centre_mm"])))
			lines.append("homing_speed: 50")
		else:
			var axis_mm := float(v["%s_mm" % str(ax["travel"])])
			lines.append("position_endstop: 0")
			lines.append("position_max: %.0f" % axis_mm)
			lines.append("homing_speed: %.0f" % (50.0 if str(ax["travel"]) != "z" else 10.0))
		lines.append("")
		lines.append("[tmc2209 %s]" % name)
		lines.append("uart_pin: PIN_%s_UART" % name.to_upper())
		lines.append("run_current: %.2f" % (float(GantryLabParts.motor(str(a["motor"]))["amps"]) * 0.7))
		lines.append("stealthchop_threshold: 999999")
		lines.append("")
	if str(tool["process"]) == "additive" and str(s["tool"]["id"]) != "clay_extruder":
		lines.append("[extruder]")
		lines.append("step_pin: PIN_E_STEP")
		lines.append("dir_pin: PIN_E_DIR")
		lines.append("enable_pin: !PIN_E_EN")
		lines.append("microsteps: 16")
		lines.append("rotation_distance: 22.68  # calibrate")
		lines.append("nozzle_diameter: %.3f" % float(tool["nozzle_mm"]))
		lines.append("filament_diameter: %.3f" % float(tool["filament_mm"]))
		lines.append("heater_pin: PIN_HE0")
		lines.append("sensor_type: EPCOS 100K B57560G104F")
		lines.append("sensor_pin: PIN_T0")
		lines.append("min_temp: 0")
		lines.append("max_temp: 300")
		lines.append("pressure_advance: 0.04")
		lines.append("")
	var bed := GantryLabParts.bed(str(s["tool"]["bed"]))
	if float(bed["watts_m2"]) > 0.0:
		lines.append("[heater_bed]")
		lines.append("heater_pin: PIN_BED")
		lines.append("sensor_type: EPCOS 100K B57560G104F")
		lines.append("sensor_pin: PIN_TB")
		lines.append("min_temp: 0")
		lines.append("max_temp: 120")
		lines.append("")
	var hz := float(d["stats"]["ringing_hz"])
	if hz > 0.0:
		lines.append("[input_shaper]")
		lines.append("shaper_freq_x: %.1f  # the belt model's estimate; measure with an accelerometer" % hz)
		lines.append("shaper_freq_y: %.1f" % hz)
		lines.append("shaper_type: mzv")
		lines.append("")
	lines.append("[mcu]")
	lines.append("serial: /dev/serial/by-id/usb-Klipper_%s" % str(GantryLabParts.board(str(e["board"]))["mcu"]).split(" ")[0])
	return "\n".join(lines) + "\n"


static func _klipper_axes(kin: String) -> Array:
	match kin:
		"delta":
			return [{"key": "z", "name": "stepper_a", "travel": "z"}, {"key": "z", "name": "stepper_b", "travel": "z"}, {"key": "z", "name": "stepper_c", "travel": "z"}]
	return [{"key": "x", "name": "stepper_x", "travel": "x"}, {"key": "y", "name": "stepper_y", "travel": "y"}, {"key": "z", "name": "stepper_z", "travel": "z"}]


static func marlin_h(d: Dictionary) -> String:
	var s: Dictionary = d["spec"]
	var kin := str(s["kinematics"])
	var e: Dictionary = s["electronics"]
	var v: Dictionary = s["volume"]
	var lines: Array = []
	lines.append("// %s — Configuration.h excerpt from the SIMbiogenesis gantry lab" % str(s["name"]))
	lines.append("// %s" % GantryLabSpec.describe(s))
	match kin:
		"corexy", "hbot":
			lines.append("#define COREXY")
		"corexz":
			lines.append("#define COREXZ")
		"delta":
			lines.append("#define DELTA")
			var r := GantryLabKinematics.delta_reach(s)
			lines.append("#define DELTA_DIAGONAL_ROD %.1f" % float(s["delta"]["arm_mm"]))
			lines.append("#define DELTA_RADIUS %.2f" % float(r["delta_radius_mm"]))
			lines.append("#define DELTA_PRINTABLE_RADIUS %.1f" % (float(v["x_mm"]) * 0.5))
			lines.append("#define DELTA_HEIGHT %.1f" % float(v["z_mm"]))
	var spm := []
	for k in ["x", "y", "z"]:
		spm.append("%.2f" % GantryLabKinematics.steps_per_mm(s["axis"][k]))
	lines.append("#define DEFAULT_AXIS_STEPS_PER_UNIT { %s, %s, %s, 93 }" % [spm[0], spm[1], spm[2]])
	var zmax := minf(float(e["max_feed_mm_s"]), 30.0 if str(s["axis"]["z"]["drive"]).begins_with("lead") else 100.0)
	if kin == "delta" or kin == "corexz":
		zmax = float(e["max_feed_mm_s"])
	lines.append("#define DEFAULT_MAX_FEEDRATE { %.0f, %.0f, %.0f, 50 }" % [float(e["max_feed_mm_s"]), float(e["max_feed_mm_s"]), zmax])
	var zacc := minf(float(e["accel_mm_s2"]), 500.0) if kin != "delta" else float(e["accel_mm_s2"])
	lines.append("#define DEFAULT_MAX_ACCELERATION { %.0f, %.0f, %.0f, 5000 }" % [float(e["accel_mm_s2"]), float(e["accel_mm_s2"]), zacc])
	lines.append("#define DEFAULT_ACCELERATION %.0f" % float(e["accel_mm_s2"]))
	lines.append("#define DEFAULT_TRAVEL_ACCELERATION %.0f" % float(e["accel_mm_s2"]))
	lines.append("#define CLASSIC_JERK")
	lines.append("#define DEFAULT_XJERK %.1f" % float(e["junction_mm_s"]))
	lines.append("#define DEFAULT_YJERK %.1f" % float(e["junction_mm_s"]))
	lines.append("#define DEFAULT_ZJERK %.1f" % minf(float(e["junction_mm_s"]), 0.4))
	lines.append("#define X_BED_SIZE %.0f" % float(v["x_mm"]))
	lines.append("#define Y_BED_SIZE %.0f" % float(v["y_mm"]))
	lines.append("#define Z_MAX_POS %.0f" % float(v["z_mm"]))
	var zn := int(s["axis"]["z"]["motors"])
	if zn >= 2 and kin != "delta":
		lines.append("#define NUM_Z_STEPPERS %d" % zn)
	lines.append("#define MOTHERBOARD BOARD_%s" % str(e["board"]).to_upper())
	return "\n".join(lines) + "\n"


static func grbl_settings(d: Dictionary) -> String:
	var s: Dictionary = d["spec"]
	var e: Dictionary = s["electronics"]
	var v: Dictionary = s["volume"]
	var lines: Array = []
	lines.append("; %s — grbl $ settings from the SIMbiogenesis gantry lab" % str(s["name"]))
	lines.append("; %s" % GantryLabSpec.describe(s))
	var keys := ["x", "y", "z"]
	for i in 3:
		lines.append("$%d=%.3f  ; %s steps/mm" % [100 + i, GantryLabKinematics.steps_per_mm(s["axis"][keys[i]]), keys[i].to_upper()])
	var zmax := minf(float(e["max_feed_mm_s"]), 30.0 if str(s["axis"]["z"]["drive"]).begins_with("lead") else 100.0)
	for i in 3:
		var f := float(e["max_feed_mm_s"]) if i < 2 else zmax
		lines.append("$%d=%.0f  ; %s max rate mm/min" % [110 + i, f * 60.0, keys[i].to_upper()])
	for i in 3:
		var a := float(e["accel_mm_s2"]) if i < 2 else minf(float(e["accel_mm_s2"]), 500.0)
		lines.append("$%d=%.0f  ; %s acceleration mm/s²" % [120 + i, a, keys[i].to_upper()])
	for i in 3:
		lines.append("$%d=%.0f  ; %s max travel mm" % [130 + i, float(v["%s_mm" % keys[i]]), keys[i].to_upper()])
	lines.append("$11=%.3f  ; junction deviation (from a %.0f mm/s corner speed)" % [float(e["junction_mm_s"]) * float(e["junction_mm_s"]) / maxf(float(e["accel_mm_s2"]), 1.0), float(e["junction_mm_s"])])
	lines.append("$20=1  ; soft limits")
	lines.append("$21=1  ; hard limits")
	lines.append("$22=1  ; homing")
	var tool := GantryLabParts.tool(str(s["tool"]["id"]))
	if str(tool["process"]) == "mark" and str(s["tool"]["id"]).begins_with("laser"):
		lines.append("$32=1  ; laser mode")
		lines.append("$30=1000  ; max spindle (laser S) value")
	return "\n".join(lines) + "\n"


static func design_json(d: Dictionary) -> String:
	var s: Dictionary = d["spec"]
	var out := {
		"name": str(s["name"]), "spec": GantryLabSpec.to_json_safe(s),
		"motors": _json_safe(d["motors"]), "stats": _json_safe(d["stats"]), "checks": d["checks"],
		"bom": {"rows": d["bom"]["rows"], "cut_list": d["bom"]["cut_list"], "usd": d["bom"]["usd"], "kg": d["bom"]["kg"]},
	}
	return JSON.stringify(out, "\t")


static func _json_safe(v: Variant) -> Variant:
	if v is Vector3:
		return [(v as Vector3).x, (v as Vector3).y, (v as Vector3).z]
	if v is Vector2:
		return [(v as Vector2).x, (v as Vector2).y]
	if v is float and not is_finite(v):
		return null
	if v is Dictionary:
		var out := {}
		for k in (v as Dictionary):
			out[str(k)] = _json_safe((v as Dictionary)[k])
		return out
	if v is Array:
		var out: Array = []
		for x in (v as Array):
			out.append(_json_safe(x))
		return out
	return v


static func safe_name(name: String) -> String:
	var out := ""
	for ch in name.to_lower():
		if "abcdefghijklmnopqrstuvwxyz0123456789".contains(ch):
			out += ch
		elif not out.ends_with("_"):
			out += "_"
	out = out.strip_edges().trim_suffix("_")
	return out if not out.is_empty() else "gantry"


## Write everything into `dir`; returns {ok, files: [paths], error}.
static func write_all(d: Dictionary, dir: String) -> Dictionary:
	var base := safe_name(str(d["spec"]["name"]))
	if DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(dir)) != OK and not DirAccess.dir_exists_absolute(ProjectSettings.globalize_path(dir)):
		return {"ok": false, "error": "cannot make %s" % dir, "files": []}
	var files := {
		"%s_printer.cfg" % base: klipper_cfg(d),
		"%s_marlin_Configuration.h" % base: marlin_h(d),
		"%s_grbl_settings.txt" % base: grbl_settings(d),
		"%s_bom.csv" % base: GantryLabBom.csv(d["bom"]),
		"%s_cut_list.txt" % base: GantryLabBom.cut_list_text(d["bom"]),
		"%s_design.json" % base: design_json(d),
	}
	var written: Array = []
	for name in files:
		var path := dir.path_join(str(name))
		var f := FileAccess.open(path, FileAccess.WRITE)
		if f == null:
			return {"ok": false, "error": "cannot write %s" % path, "files": written}
		f.store_string(str(files[name]))
		f.close()
		written.append(path)
	return {"ok": true, "files": written, "error": ""}
