class_name GantryLabSamples
extends RefCounted

## Sample G-code programs, generated to fit a design's volume and tool, in
## the dialect the tool speaks (RepRap flavour with E words for an extruder;
## grbl with M3/M5 and S for a spindle or laser; plain G0/G1 with Z lifts
## for a pen). They are real programs — a slicer would write the same words
## — so the parser, the planner and the placed machine all run the same
## thing the player can read in the text box.
##
## list(spec) → [{id, label, blurb}];  text(spec, id) → String

const SAMPLES := [
	{"id": "cube", "label": "Calibration cube (20 mm)", "blurb": "Three perimeters a layer: the classic first print. Watch the corners — that is where jerk and belt stretch show.", "process": ["additive"]},
	{"id": "vase", "label": "Spiral vase", "blurb": "One continuous wall climbing in Z: no retractions, every move an arc chord. A delta's favourite.", "process": ["additive"]},
	{"id": "bridge", "label": "Speed test (zigzag + diagonals)", "blurb": "Long straight runs at full feed, then diagonals: a CoreXY's A and B motors trade speed as the direction turns.", "process": ["additive", "mark"]},
	{"id": "pocket", "label": "Router pocket + outline", "blurb": "A rectangular pocket cleared in passes, then the outline: rapids up, plunges, feeds. The subtractive program.", "process": ["subtractive"]},
	{"id": "logo", "label": "Laser raster + vector", "blurb": "A filled shape as back-and-forth raster lines, then its outline as a vector cut; S sets the laser power.", "process": ["mark"]},
	{"id": "plotter", "label": "Plotter shapes", "blurb": "Square, triangle, circle with pen lifts between them: G0 travel, G1 draw, Z up and down.", "process": ["mark", "additive", "subtractive"]},
	{"id": "spiral_pass", "label": "Face / surfacing pass", "blurb": "Overlapping parallel passes across the whole bed at the tool's step-over: how long a spoilboard surfacing takes.", "process": ["subtractive"]},
]


static func list(spec: Dictionary) -> Array:
	var s := GantryLabSpec.resolve(spec)
	var process := str(GantryLabParts.tool(str(s["tool"]["id"]))["process"])
	var out: Array = []
	for smp in SAMPLES:
		if (smp["process"] as Array).has(process):
			out.append({"id": str(smp["id"]), "label": str(smp["label"]), "blurb": str(smp["blurb"])})
	return out


static func text(spec: Dictionary, id: String) -> String:
	var s := GantryLabSpec.resolve(spec)
	match id:
		"cube":
			return _cube(s)
		"vase":
			return _vase(s)
		"bridge":
			return _bridge(s)
		"pocket":
			return _pocket(s)
		"logo":
			return _logo(s)
		"plotter":
			return _plotter(s)
		"spiral_pass":
			return _surfacing(s)
	return _cube(s)


static func _tool(s: Dictionary) -> Dictionary:
	return GantryLabParts.tool(str(s["tool"]["id"]))


static func _centre(s: Dictionary) -> Vector2:
	var v: Dictionary = s["volume"]
	if str(s["kinematics"]) == "delta":
		return Vector2.ZERO
	return Vector2(float(v["x_mm"]) * 0.5, float(v["y_mm"]) * 0.5)


## Extrusion length per mm of line (mm of filament): w·h / (π r²).
static func _e_per_mm(s: Dictionary) -> float:
	var t := _tool(s)
	var w := float(t["nozzle_mm"])
	var h := float(t["layer_mm"])
	var fd := maxf(float(t["filament_mm"]), 0.1)
	return w * h / (PI * fd * fd * 0.25)


static func _header(s: Dictionary, name: String) -> Array:
	var t := _tool(s)
	var lines: Array = ["; %s — generated by the SIMbiogenesis gantry lab for %s" % [name, str(s["name"])], "G21 ; mm", "G90 ; absolute"]
	match str(t["process"]):
		"additive":
			if str(s["tool"]["id"]) != "clay_extruder":
				lines.append("M82 ; absolute E")
				lines.append("M140 S60")
				lines.append("M104 S210")
				lines.append("M190 S60")
				lines.append("M109 S210")
			lines.append("G28 ; home")
			lines.append("G92 E0")
		"subtractive":
			lines.append("G28")
			lines.append("M3 S12000 ; spindle on")
		"mark":
			lines.append("G28")
	return lines


static func _footer(s: Dictionary) -> Array:
	var t := _tool(s)
	match str(t["process"]):
		"additive":
			return ["G0 Z%.1f" % minf(float(s["volume"]["z_mm"]), 30.0 + 10.0), "M104 S0", "M140 S0", "G28 X Y", "M84"]
		"subtractive":
			return ["G0 Z10", "M5 ; spindle off", "G0 X0 Y0"]
	return ["G0 Z5", "G0 X0 Y0"]


static func _cube(s: Dictionary) -> String:
	var t := _tool(s)
	var side := clampf(20.0 * maxf(float(t["nozzle_mm"]) / 0.4, 1.0), 20.0, minf(float(s["volume"]["x_mm"]), float(s["volume"]["y_mm"])) * 0.6)
	var c := _centre(s)
	var layer := float(t["layer_mm"])
	var w := float(t["nozzle_mm"])
	var feed := float(t["feed_mm_s"]) * 60.0
	var epm := _e_per_mm(s)
	var e := 0.0
	var lines := _header(s, "Calibration cube")
	var n_layers := clampi(int(side / layer), 4, 120)
	var x0 := c.x - side * 0.5
	var y0 := c.y - side * 0.5
	for li in n_layers:
		var z := layer * (li + 1)
		lines.append(";LAYER:%d" % li)
		lines.append("G0 Z%.2f F%d" % [z, 600])
		for p in 3:
			var inset := w * p
			var ax := x0 + inset
			var ay := y0 + inset
			var l := side - 2.0 * inset
			lines.append("G0 X%.3f Y%.3f F%d" % [ax, ay, int(feed * 2.0)])
			var corners := [Vector2(ax + l, ay), Vector2(ax + l, ay + l), Vector2(ax, ay + l), Vector2(ax, ay)]
			var prev := Vector2(ax, ay)
			for q in corners:
				var qv: Vector2 = q
				e += prev.distance_to(qv) * epm
				lines.append("G1 X%.3f Y%.3f E%.4f F%d" % [qv.x, qv.y, e, int(feed)])
				prev = qv
		# Sparse infill: one diagonal every other layer.
		if li % 2 == 1 and li > 1:
			var inset := w * 3.0
			lines.append("G0 X%.3f Y%.3f" % [x0 + inset, y0 + inset])
			e += (side - 2.0 * inset) * 1.414 * epm
			lines.append("G1 X%.3f Y%.3f E%.4f F%d" % [x0 + side - inset, y0 + side - inset, e, int(feed)])
	lines.append_array(_footer(s))
	return "\n".join(lines) + "\n"


static func _vase(s: Dictionary) -> String:
	var t := _tool(s)
	var v: Dictionary = s["volume"]
	var r := minf(float(v["x_mm"]), float(v["y_mm"])) * 0.22
	var h := minf(float(v["z_mm"]) * 0.6, r * 3.0)
	var c := _centre(s)
	var layer := float(t["layer_mm"])
	var feed := float(t["feed_mm_s"]) * 60.0
	var epm := _e_per_mm(s)
	var e := 0.0
	var lines := _header(s, "Spiral vase")
	var n_layers := clampi(int(h / layer), 6, 400)
	var segs := 48
	var prev := Vector3(c.x + r, c.y, layer)
	lines.append("G0 X%.3f Y%.3f Z%.2f F%d" % [prev.x, prev.y, layer, 3000])
	for li in n_layers:
		if li % 10 == 0:
			lines.append(";LAYER:%d" % li)
		for k in range(1, segs + 1):
			var f := float(li) + float(k) / float(segs)
			var ang := TAU * float(k) / float(segs)
			var wobble := 1.0 + 0.12 * sin(5.0 * ang + f * 0.15) * sin(f / n_layers * PI)
			var p := Vector3(c.x + cos(ang) * r * wobble, c.y + sin(ang) * r * wobble, layer * (1.0 + f))
			e += prev.distance_to(p) * epm
			lines.append("G1 X%.3f Y%.3f Z%.3f E%.4f F%d" % [p.x, p.y, p.z, e, int(feed)])
			prev = p
	lines.append_array(_footer(s))
	return "\n".join(lines) + "\n"


static func _bridge(s: Dictionary) -> String:
	var t := _tool(s)
	var v: Dictionary = s["volume"]
	var w := float(v["x_mm"]) * 0.8
	var dd := float(v["y_mm"]) * 0.8
	var c := _centre(s)
	var x0 := c.x - w * 0.5
	var y0 := c.y - dd * 0.5
	var feed := float(s["electronics"]["max_feed_mm_s"]) * 60.0
	var additive := str(t["process"]) == "additive"
	var epm := _e_per_mm(s) if additive else 0.0
	var e := 0.0
	var lines := _header(s, "Speed test")
	var z := float(t["layer_mm"]) if additive else 0.0
	if str(t["process"]) == "mark":
		lines.append("M3 S300")
	lines.append("G0 X%.3f Y%.3f Z%.2f F%d" % [x0, y0, z, int(feed)])
	var rows := 10
	var prev := Vector2(x0, y0)
	for i in rows:
		var y := y0 + dd * float(i) / float(rows - 1)
		var xa := x0 if i % 2 == 0 else x0 + w
		var xb := x0 + w if i % 2 == 0 else x0
		for p in [Vector2(xa, y), Vector2(xb, y)]:
			var pv: Vector2 = p
			e += prev.distance_to(pv) * epm
			lines.append("G1 X%.3f Y%.3f%s F%d" % [pv.x, pv.y, (" E%.4f" % e) if additive else "", int(feed)])
			prev = pv
	# Diagonals and a diamond.
	for p in [Vector2(x0, y0), Vector2(x0 + w, y0 + dd), Vector2(x0 + w, y0), Vector2(x0, y0 + dd), Vector2(c.x, y0), Vector2(x0 + w, c.y), Vector2(c.x, y0 + dd), Vector2(x0, c.y), Vector2(c.x, y0)]:
		var pv: Vector2 = p
		e += prev.distance_to(pv) * epm
		lines.append("G1 X%.3f Y%.3f%s F%d" % [pv.x, pv.y, (" E%.4f" % e) if additive else "", int(feed)])
		prev = pv
	if str(t["process"]) == "mark":
		lines.append("M5")
	lines.append_array(_footer(s))
	return "\n".join(lines) + "\n"


static func _pocket(s: Dictionary) -> String:
	var t := _tool(s)
	var v: Dictionary = s["volume"]
	var c := _centre(s)
	var pw := minf(float(v["x_mm"]), 400.0) * 0.4
	var ph := minf(float(v["y_mm"]), 400.0) * 0.3
	var bit := float(t["nozzle_mm"])
	var step := bit * 0.45
	var pass_mm := float(t["layer_mm"])
	var depth := minf(pass_mm * 4.0, float(v["z_mm"]) * 0.3)
	var feed := float(t["feed_mm_s"]) * 60.0
	var plunge := feed * 0.3
	var lines := _header(s, "Pocket and outline")
	var x0 := c.x - pw * 0.5
	var y0 := c.y - ph * 0.5
	var safe := 8.0
	lines.append("G0 Z%.1f" % safe)
	var z := 0.0
	while z > -depth + 1e-6:
		z = maxf(z - pass_mm, -depth)
		lines.append("(pass at Z%.2f)" % z)
		lines.append("G0 X%.3f Y%.3f" % [x0 + bit, y0 + bit])
		lines.append("G1 Z%.3f F%d" % [z, int(plunge)])
		# Spiral inward.
		var ax := x0 + bit
		var ay := y0 + bit
		var bx := x0 + pw - bit
		var by := y0 + ph - bit
		var k := 0
		while bx - ax > step and by - ay > step and k < 400:
			lines.append("G1 X%.3f Y%.3f F%d" % [bx, ay, int(feed)])
			lines.append("G1 X%.3f Y%.3f" % [bx, by])
			lines.append("G1 X%.3f Y%.3f" % [ax, by])
			ay += step
			lines.append("G1 X%.3f Y%.3f" % [ax, ay])
			ax += step
			bx -= step
			by -= step
			k += 1
		lines.append("G0 Z%.1f" % safe)
	# Outline with a lead-in arc.
	lines.append("(outline)")
	lines.append("G0 X%.3f Y%.3f" % [x0 - bit * 0.5 - 6.0, y0 - bit * 0.5])
	lines.append("G1 Z%.3f F%d" % [-depth, int(plunge)])
	lines.append("G2 X%.3f Y%.3f I6 J0 F%d" % [x0 - bit * 0.5, y0 - bit * 0.5 + 0.0, int(feed)])
	lines.append("G1 X%.3f Y%.3f" % [x0 + pw + bit * 0.5, y0 - bit * 0.5])
	lines.append("G1 X%.3f Y%.3f" % [x0 + pw + bit * 0.5, y0 + ph + bit * 0.5])
	lines.append("G1 X%.3f Y%.3f" % [x0 - bit * 0.5, y0 + ph + bit * 0.5])
	lines.append("G1 X%.3f Y%.3f" % [x0 - bit * 0.5, y0 - bit * 0.5])
	lines.append("G0 Z%.1f" % safe)
	lines.append_array(_footer(s))
	return "\n".join(lines) + "\n"


static func _logo(s: Dictionary) -> String:
	var t := _tool(s)
	var v: Dictionary = s["volume"]
	var c := _centre(s)
	var r := minf(float(v["x_mm"]), float(v["y_mm"])) * 0.18
	var spot := maxf(float(t["nozzle_mm"]), 0.1)
	var line_gap := spot * 1.5
	var feed := float(t["feed_mm_s"]) * 60.0
	var lines := _header(s, "Raster and vector")
	lines.append("G0 Z0")
	# Raster a filled ring: lines across the disc, laser on inside the annulus.
	var y := -r
	var n := 0
	while y <= r and n < 4000:
		var half := sqrt(maxf(r * r - y * y, 0.0))
		var inner := r * 0.55
		var ih := sqrt(maxf(inner * inner - y * y, 0.0)) if absf(y) < inner else 0.0
		var dir := 1.0 if n % 2 == 0 else -1.0
		var xs := [-half, -ih, ih, half] if dir > 0.0 else [half, ih, -ih, -half]
		lines.append("G0 X%.3f Y%.3f" % [c.x + float(xs[0]), c.y + y])
		lines.append("M3 S600")
		lines.append("G1 X%.3f Y%.3f F%d" % [c.x + float(xs[1]), c.y + y, int(feed * 2.0)])
		if ih > 0.0:
			lines.append("M5")
			lines.append("G0 X%.3f Y%.3f" % [c.x + float(xs[2]), c.y + y])
			lines.append("M3 S600")
		lines.append("G1 X%.3f Y%.3f F%d" % [c.x + float(xs[3]), c.y + y, int(feed * 2.0)])
		lines.append("M5")
		y += line_gap
		n += 1
	# Vector outline: two circles as arcs.
	for rr in [r, r * 0.55]:
		lines.append("G0 X%.3f Y%.3f" % [c.x + float(rr), c.y])
		lines.append("M3 S1000")
		lines.append("G2 X%.3f Y%.3f I%.3f J0 F%d" % [c.x + float(rr), c.y, -float(rr), int(feed)])
		lines.append("M5")
	lines.append_array(_footer(s))
	return "\n".join(lines) + "\n"


static func _plotter(s: Dictionary) -> String:
	var v: Dictionary = s["volume"]
	var c := _centre(s)
	var sz := minf(float(v["x_mm"]), float(v["y_mm"])) * 0.2
	var feed := float(_tool(s)["feed_mm_s"]) * 60.0
	var lines := _header(s, "Plotter shapes")
	var up := 3.0
	var shapes: Array = []
	var sq: Array = []
	var sx := c.x - sz * 1.3
	for p in [Vector2(-0.5, -0.5), Vector2(0.5, -0.5), Vector2(0.5, 0.5), Vector2(-0.5, 0.5), Vector2(-0.5, -0.5)]:
		sq.append(Vector2(sx, c.y) + (p as Vector2) * sz)
	shapes.append(sq)
	var tr: Array = []
	for p in [Vector2(-0.5, -0.45), Vector2(0.5, -0.45), Vector2(0.0, 0.45), Vector2(-0.5, -0.45)]:
		tr.append(Vector2(c.x, c.y) + (p as Vector2) * sz)
	shapes.append(tr)
	var ci: Array = []
	for k in 37:
		var a := TAU * float(k) / 36.0
		ci.append(Vector2(c.x + sz * 1.3 + cos(a) * sz * 0.5, c.y + sin(a) * sz * 0.5))
	shapes.append(ci)
	for sh in shapes:
		var pts: Array = sh
		lines.append("G0 Z%.1f" % up)
		lines.append("G0 X%.3f Y%.3f" % [(pts[0] as Vector2).x, (pts[0] as Vector2).y])
		lines.append("G1 Z0 F%d" % int(feed * 0.5))
		for i in range(1, pts.size()):
			lines.append("G1 X%.3f Y%.3f F%d" % [(pts[i] as Vector2).x, (pts[i] as Vector2).y, int(feed)])
	lines.append_array(_footer(s))
	return "\n".join(lines) + "\n"


static func _surfacing(s: Dictionary) -> String:
	var t := _tool(s)
	var v: Dictionary = s["volume"]
	var bit := maxf(float(t["nozzle_mm"]), 1.0)
	var step := bit * 0.8
	var w := float(v["x_mm"])
	var dd := float(v["y_mm"])
	var feed := float(t["max_feed_mm_s"]) * 60.0
	var lines := _header(s, "Surfacing pass")
	lines.append("G0 Z5")
	lines.append("G0 X0 Y0")
	lines.append("G1 Z-0.5 F%d" % int(feed * 0.2))
	var y := 0.0
	var i := 0
	while y <= dd and i < 3000:
		var xa := 0.0 if i % 2 == 0 else w
		var xb := w if i % 2 == 0 else 0.0
		lines.append("G1 X%.3f Y%.3f F%d" % [xa, y, int(feed)])
		lines.append("G1 X%.3f Y%.3f" % [xb, y])
		y += step
		i += 1
	lines.append_array(_footer(s))
	return "\n".join(lines) + "\n"
